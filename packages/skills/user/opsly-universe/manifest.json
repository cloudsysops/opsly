{
  "name": "opsly-universe",
  "version": "1.0.0",
  "description": "Canon de personajes, mundos y Visual DNA de OPSLY Universe para todos los agentes",
  "inputSchema": {
    "type": "object",
    "properties": {
      "capability": {
        "type": "string",
        "enum": [
          "universe.character.lookup",
          "universe.character.compose",
          "universe.story.compose",
          "universe.prompt.image",
          "universe.prompt.video",
          "universe.prompt.dialogue",
          "universe.world.lookup"
        ]
      },
      "characterId": { "type": "string" },
      "topic": { "type": "string" },
      "tenant": { "type": "string" }
    },
    "additionalProperties": true
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "canonVersion": { "type": "string" },
      "characters": { "type": "array" }
    }
  }
}
