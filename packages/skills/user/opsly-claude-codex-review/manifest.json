{
  "name": "opsly-claude-codex-review",
  "version": "1.0.0",
  "description": "Claude Code builder + Codex MCP independent reviewer (AI Board loop)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "diff_range": { "type": "string", "description": "Git range or path to review" },
      "acceptance_criteria": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["APPROVED", "REQUEST_CHANGES", "BLOCKED"]
      },
      "findings": { "type": "array" }
    }
  }
}
