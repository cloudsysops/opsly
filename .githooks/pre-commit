#!/usr/bin/env bash
# Lightweight pre-commit: structure + diff-scoped checks only.
# Heavy validation (type-check, openapi, manifest tests) runs in pre-push / CI.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# shellcheck source=scripts/hooks/hook-bootstrap.sh
source "$ROOT/scripts/hooks/hook-bootstrap.sh"

opsly_hook_bootstrap_runtime || {
  echo "❌ Could not resolve node/npm/npx for pre-commit" >&2
  exit 1
}
opsly_hook_require npm

STAGED_FILES="$(opsly_hook_staged_files)"

if [[ -z "$STAGED_FILES" ]]; then
  echo "ℹ️ No staged files; skipping pre-commit."
  exit 0
fi

echo "🔍 pre-commit (lightweight)..."

echo "🧭 validate-structure"
npm run validate-structure --silent

if [[ -x scripts/hooks/structure-guard.sh ]]; then
  bash scripts/hooks/structure-guard.sh
fi

# Diff-scoped workspace tests (lib modules only — cheap, no turbo)
if opsly_hook_files_match "$STAGED_FILES" '^lib/prompts/'; then
  echo "🔐 lib/prompts changed → test @intcloudsysops/prompts"
  npm run test --workspace=@intcloudsysops/prompts --silent
fi

if opsly_hook_files_match "$STAGED_FILES" '^lib/observability/'; then
  echo "📊 lib/observability changed → test @intcloudsysops/observability"
  npm run test --workspace=@intcloudsysops/observability --silent
fi

if opsly_hook_files_match "$STAGED_FILES" '^lib/components/'; then
  echo "🎨 lib/components changed → test @intcloudsysops/components"
  npm run test --workspace=@intcloudsysops/components --silent
fi

if opsly_hook_files_match "$STAGED_FILES" '^lib/evaluation/'; then
  echo "✅ lib/evaluation changed → test @intcloudsysops/evaluation"
  npm run test --workspace=@intcloudsysops/evaluation --silent
fi

CANONICAL_FILES=(
  "VISION.md"
  "ROADMAP.md"
  "AGENTS.md"
  "README.md"
  "docs/README.md"
  "docs/index.md"
  "docs/STRUCTURE-GUARDRAILS.md"
  "config/docs-root-allowlist.json"
  "config/modules.json"
)

MODIFIED_CANONICAL=()
for file in "${CANONICAL_FILES[@]}"; do
  if printf '%s\n' "$STAGED_FILES" | grep -qx "$file"; then
    MODIFIED_CANONICAL+=("$file")
  fi
done

if ((${#MODIFIED_CANONICAL[@]} > 0)); then
  echo "⚠️  Canonical files staged: ${MODIFIED_CANONICAL[*]}"
  echo "   commit-msg hook will require docs/chore/feat prefix."
fi

echo "🔎 duplicate scan (non-blocking)"
bash scripts/check-duplicates.sh lib/components lib/services 2>/dev/null || true

echo "✨ pre-commit OK"
exit 0
