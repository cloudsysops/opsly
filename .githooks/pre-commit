#!/bin/bash
# Pre-commit hooks for Opsly modules

set -e

if ! command -v npm >/dev/null 2>&1; then
  for candidate in \
    /usr/local/opt/node@20/bin \
    /opt/homebrew/opt/node@20/bin
  do
    if [ -d "$candidate" ]; then
      export PATH="$candidate:$PATH"
      break
    fi
  done
fi

echo "🔍 Running pre-commit validation..."

# 1. Repository structure
echo "🧭 Validating repository structure..."
npm run validate-structure --silent || {
  echo "❌ Structure validation failed"
  exit 1
}

if [ -x scripts/hooks/structure-guard.sh ]; then
  bash scripts/hooks/structure-guard.sh || {
    echo "❌ Structure guard failed"
    exit 1
  }
fi

# 2. Type check
echo "📋 Type checking..."
npm run type-check 2>/dev/null || {
  echo "❌ Type check failed"
  exit 1
}

# 3. Validate lib/prompts
if git diff --cached --name-only | grep -q "lib/prompts/"; then
  echo "🔐 Validating prompts..."
  npm run test --workspace=@intcloudsysops/prompts 2>/dev/null || {
    echo "❌ Prompt validation failed"
    exit 1
  }
fi

# 4. Validate lib/observability
if git diff --cached --name-only | grep -q "lib/observability/"; then
  echo "📊 Validating observability..."
  npm run test --workspace=@intcloudsysops/observability 2>/dev/null || {
    echo "❌ Observability validation failed"
    exit 1
  }
fi

# 5. Validate lib/components
if git diff --cached --name-only | grep -q "lib/components/"; then
  echo "🎨 Validating components..."
  npm run test --workspace=@intcloudsysops/components 2>/dev/null || {
    echo "❌ Component validation failed"
    exit 1
  }
fi

# 6. Validate lib/evaluation
if git diff --cached --name-only | grep -q "lib/evaluation/"; then
  echo "✅ Validating evaluation..."
  npm run test --workspace=@intcloudsysops/evaluation 2>/dev/null || {
    echo "❌ Evaluation validation failed"
    exit 1
  }
fi

# 7. Check for duplicates
echo "🔎 Checking for code duplication..."
bash scripts/check-duplicates.sh lib/components lib/services 2>/dev/null || true

# 8. Lint
echo "🎯 Linting..."
npm run lint -- --fix 2>/dev/null || true

# 9. Protect canonical documentation
echo "🔒 Validating canonical documentation integrity..."
CANONICAL_FILES="VISION.md ROADMAP.md AGENTS.md README.md docs/README.md docs/index.md docs/STRUCTURE-GUARDRAILS.md config/docs-root-allowlist.json config/modules.json"
MODIFIED_CANONICAL=""

for file in $CANONICAL_FILES; do
  if git diff --cached --name-only | grep -q "^$file$"; then
    MODIFIED_CANONICAL="$MODIFIED_CANONICAL $file"
  fi
done

if [ -n "$MODIFIED_CANONICAL" ]; then
  echo "⚠️  Canonical files detected in commit:$MODIFIED_CANONICAL"

  # Check if commit message indicates intentional update
  COMMIT_MSG=$(cat /dev/stdin 2>/dev/null || echo "")
  if ! echo "$COMMIT_MSG" | grep -qE "(docs|chore|feat)(\(.*\))?: |UPDATE_CANONICAL=true"; then
    # During pre-commit, we don't have the commit message yet
    # Just warn the user; the actual validation happens in commit-msg hook
    echo "ℹ️  Canonical file changes require commit message like: docs(agents): update session state"
  fi
fi

echo "✨ Pre-commit validation passed!"
exit 0
