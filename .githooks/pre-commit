#!/bin/bash
# Pre-commit hooks for Opsly modules

set -e

echo "🔍 Running pre-commit validation..."

# 1. Type check
echo "📋 Type checking..."
npm run type-check 2>/dev/null || {
  echo "❌ Type check failed"
  exit 1
}

# 2. Validate lib/prompts
if git diff --cached --name-only | grep -q "lib/prompts/"; then
  echo "🔐 Validating prompts..."
  npm run test --workspace=@intcloudsysops/prompts 2>/dev/null || {
    echo "❌ Prompt validation failed"
    exit 1
  }
fi

# 3. Validate lib/observability
if git diff --cached --name-only | grep -q "lib/observability/"; then
  echo "📊 Validating observability..."
  npm run test --workspace=@intcloudsysops/observability 2>/dev/null || {
    echo "❌ Observability validation failed"
    exit 1
  }
fi

# 4. Validate lib/components
if git diff --cached --name-only | grep -q "lib/components/"; then
  echo "🎨 Validating components..."
  npm run test --workspace=@intcloudsysops/components 2>/dev/null || {
    echo "❌ Component validation failed"
    exit 1
  }
fi

# 5. Validate lib/evaluation
if git diff --cached --name-only | grep -q "lib/evaluation/"; then
  echo "✅ Validating evaluation..."
  npm run test --workspace=@intcloudsysops/evaluation 2>/dev/null || {
    echo "❌ Evaluation validation failed"
    exit 1
  }
fi

# 6. Check for duplicates
echo "🔎 Checking for code duplication..."
bash scripts/check-duplicates.sh lib/components lib/services 2>/dev/null || true

# 7. Lint
echo "🎯 Linting..."
npm run lint -- --fix 2>/dev/null || true

echo "✨ Pre-commit validation passed!"
exit 0
