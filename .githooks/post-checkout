#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  exit 0
fi

cd "$ROOT"

OLD_REF="${1:-}"
NEW_REF="${2:-}"
FLAG="${3:-}"

echo "🔀 Branch checkout detected"
if [[ -n "$OLD_REF" || -n "$NEW_REF" ]]; then
  echo "   from: ${OLD_REF:-unknown}"
  echo "   to:   ${NEW_REF:-unknown}"
fi

if [[ "${FLAG:-0}" == "1" ]]; then
  echo "   event: branch checkout"
else
  echo "   event: path checkout or ref update"
fi

if [[ -x "$ROOT/scripts/git-session-brief.sh" ]]; then
  bash "$ROOT/scripts/git-session-brief.sh"
else
  echo "⚠️  session brief no disponible"
fi
