#!/usr/bin/env bash
set -euo pipefail

if ! command -v npx >/dev/null 2>&1; then
  for candidate in \
    /usr/local/opt/node@20/bin \
    /opt/homebrew/opt/node@20/bin
  do
    if [ -d "$candidate" ]; then
      export PATH="$candidate:$PATH"
      break
    fi
  done
fi

ROOT="$(git rev-parse --show-toplevel)"
MSG_FILE="${1:-}"

if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
  echo "commit-msg: missing commit message file"
  exit 1
fi

cd "$ROOT"

# Read commit message
COMMIT_MSG=$(cat "$MSG_FILE")

# Check if canonical files are being modified
CANONICAL_FILES="VISION.md ROADMAP.md AGENTS.md README.md docs/README.md docs/index.md docs/STRUCTURE-GUARDRAILS.md config/docs-root-allowlist.json config/modules.json"
MODIFIED_CANONICAL=""

for file in $CANONICAL_FILES; do
  if git diff --cached --name-only 2>/dev/null | grep -q "^$file$"; then
    MODIFIED_CANONICAL="$MODIFIED_CANONICAL $file"
  fi
done

# If canonical files modified, ensure commit message indicates intentional update
if [ -n "$MODIFIED_CANONICAL" ]; then
  if ! echo "$COMMIT_MSG" | grep -qE "^(docs|chore|feat)(\(.+\))?: |^\[CANONICAL\]|^UPDATE_DOCS"; then
    echo ""
    echo "❌ Canonical files detected:$MODIFIED_CANONICAL"
    echo ""
    echo "Canonical files require explicit documentation of why they changed."
    echo "Use commit messages like:"
    echo "  - docs(agents): update session state and progress"
    echo "  - docs(roadmap): Q2 2026 milestone updates"
    echo "  - chore(modules): register new lib module"
    echo ""
    exit 1
  fi
fi

npx commitlint --edit "$MSG_FILE"
