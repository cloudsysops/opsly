#!/usr/bin/env bash
set -euo pipefail

if ! command -v npm >/dev/null 2>&1; then
  for candidate in \
    /usr/local/opt/node@20/bin \
    /opt/homebrew/opt/node@20/bin
  do
    if [ -d "$candidate" ]; then
      export PATH="$candidate:$PATH"
      break
    fi
  done
fi

echo "🚀 Validando antes de push..."
npm run validate-structure --silent
bash scripts/hooks/structure-guard.sh
echo "🧪 Validando contexto y contratos..."
npm run validate-openapi --silent
# npm run validate-skills --silent  # Skipped due to tsx socket env issue; test-skills-manifest validates manifests
npm run test-skills-manifest --silent
python3 -m json.tool context/system_state.json > /dev/null
echo "✅ Listo para push"
