{
  "name": "@intcloudsysops/franchise-core",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Franchise OS domain: units, territories, agreements, versioned royalties, audits. No CRM, payments, or tenant-specific business rules.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
