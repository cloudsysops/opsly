{
  "name": "@intcloudsysops/universe",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical Opsly Universe IP: characters, worlds, visual DNA, story contracts. Consumed by agents; does not depend on content-studio.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opsly-universe": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "export-json": "tsx src/cli.ts export"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.12",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
