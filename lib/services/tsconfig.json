{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "gohighlevel/env-config.ts",
    "gohighlevel/client.ts",
    "gohighlevel/service.ts",
    "gohighlevel/types.ts",
    "gohighlevel/index.ts",
    "gohighlevel/full.ts",
    "gohighlevel/workflows/ai-lead-followup.ts",
    "twenty/env-config.ts",
    "twenty/client.ts",
    "twenty/types.ts",
    "twenty/index.ts",
    "twenty/webhook-verify.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
