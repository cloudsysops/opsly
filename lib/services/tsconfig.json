{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "shims.d.ts",
    "twenty/env-config.ts",
    "twenty/client.ts",
    "twenty/types.ts",
    "twenty/index.ts",
    "entitlements/client.ts",
    "entitlements/types.ts",
    "entitlements/index.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
