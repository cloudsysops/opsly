{
  "name": "@intcloudsysops/services",
  "version": "1.0.0",
  "description": "Shared service layer (repositories, integrations)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./twenty": {
      "types": "./dist/twenty/index.d.ts",
      "import": "./dist/twenty/index.js",
      "default": "./dist/twenty/index.js"
    },
    "./twenty/index.js": {
      "types": "./dist/twenty/index.d.ts",
      "import": "./dist/twenty/index.js",
      "default": "./dist/twenty/index.js"
    },
    "./entitlements": {
      "types": "./dist/entitlements/index.d.ts",
      "import": "./dist/entitlements/index.js",
      "default": "./dist/entitlements/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "keywords": ["services"]
}
