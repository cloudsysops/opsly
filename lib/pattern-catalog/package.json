{
  "name": "@intcloudsysops/pattern-catalog",
  "version": "0.1.0",
  "description": "Opsly pattern catalog loader — harness, tenant, and opsly scaffolds from config/patterns",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
