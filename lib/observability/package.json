{
  "name": "@intcloudsysops/observability",
  "version": "1.0.0",
  "description": "Unified logging, metrics, and tracing layer",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    },
    "./metrics": {
      "import": "./dist/metrics.js",
      "types": "./dist/metrics.d.ts"
    },
    "./tracing": {
      "import": "./dist/tracing.js",
      "types": "./dist/tracing.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "pino": "^8.0.0",
    "prom-client": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
