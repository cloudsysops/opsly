{
  "name": "@intcloudsysops/franchise-persistence",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase/Postgres adapter for Franchise OS. Domain stays in @intcloudsysops/franchise-core.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intcloudsysops/franchise-core": "*",
    "@supabase/supabase-js": "^2.106.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.12",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
