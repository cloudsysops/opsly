{
  "name": "@intcloudsysops/orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Opsly BullMQ orchestrator (queues, workers, OpenClaw routing in TS). Not the OpenClaw CLI (npm openclaw).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:hermes": "vitest run __tests__/hermes.test.ts src/hermes/__tests__/context-enricher.test.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:tools": "vitest run --passWithNoTests src/agents/tools",
    "type-check": "tsc --noEmit",
    "hive-run": "tsx src/hive/hive-run.ts",
    "iteration-watch": "tsx scripts/iteration-watch-responses.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@anthropic-ai/sdk": "^0.57.0",
    "@intcloudsysops/content-studio": "*",
    "@intcloudsysops/agent-task-core": "*",
    "@intcloudsysops/external-agent-registry": "*",
    "@intcloudsysops/git-branch-orchestrator": "*",
    "@intcloudsysops/llm-gateway": "*",
    "@intcloudsysops/ml": "^1.0.0",
    "@intcloudsysops/prompt-guard": "*",
    "@intcloudsysops/runtime": "*",
    "@intcloudsysops/session-manager": "*",
    "@intcloudsysops/sigma-harness": "*",
    "@intcloudsysops/types": "*",
    "@intcloudsysops/voice-messaging": "*",
    "@llamaindex/postgres": "^0.0.65",
    "@supabase/supabase-js": "^2.49.1",
    "@tavily/core": "^0.7.2",
    "ai": "^6.0.168",
    "axios": "^1.15.0",
    "bullmq": "^5.58.5",
    "execa": "^9.6.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.4.2",
    "langchain": "^1.3.1",
    "langfuse": "^3.0.0",
    "langsmith": "^0.7.1",
    "litellm": "^0.12.0",
    "llamaindex": "^0.12.1",
    "pg": "^8.20.0",
    "redis": "^5.0.0",
    "stripe": "^17.7.0",
    "tavily": "^2.0.0",
    "ws": "^8.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.12",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.11",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
