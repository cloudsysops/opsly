# Orchestrator — copiar a .env local o cargar vía Doppler (no commitear secretos).

# Raíz del repo (system_state.json en runtime/context/ para Cortex)
# OPSLY_ROOT=/path/to/opsly

# Opsly Cortex (control plane): ciclo OODA + encolado acotado (requiere llm-gateway alcanzable)
# OPSLY_CORTEX_ENABLED=true
# OPSLY_CORTEX_DRY_RUN=true
# OPSLY_CORTEX_INTERVAL_MINUTES=15
# OPSLY_CORTEX_MIN_INTERVAL_MINUTES=15
# OPSLY_CORTEX_MAX_ENQUEUES_PER_HOUR=8
# OPSLY_CORTEX_STRATEGIC_HOUR_UTC=5
# OPSLY_CORTEX_REFLECTION_HOUR_UTC=20
# ORCHESTRATOR_LLM_GATEWAY_URL=http://llm-gateway:3010
# OPSLY_CORTEX_MODEL=claude-sonnet-4-20250514

# Procesar jobs sandbox_execution en cola openclaw (requiere Docker + scripts/run-in-sandbox.sh en cwd)
# OPSLY_SANDBOX_WORKER_ENABLED=true

# Redis (BullMQ / PubSub OAR)
# REDIS_URL=redis://127.0.0.1:6379

# Langfuse (X-Ray / trazas OAR — doble escritura con Redis)
# Self-hosted: URL alcanzable desde el proceso del orchestrator (red Docker o Tailscale).
LANGFUSE_PUBLIC_KEY=pk-xxxxx
LANGFUSE_SECRET_KEY=sk-xxxxx
# Host base de la API Langfuse (v3 SDK usa baseUrl). Ejemplo en VPS: servicio interno compose.
LANGFUSE_HOST=http://langfuse:3000
