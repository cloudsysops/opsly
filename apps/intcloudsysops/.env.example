NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origins used by auth redirect helpers and invite emails
NEXT_PUBLIC_INTCLOUDSYSOPS_SITE_URL=http://localhost:3005
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002

NEXT_PUBLIC_TENANT_ID=intcloudsysops

# Admin dashboard authentication
DASHBOARD_ADMIN_SECRET=your-secure-admin-token

# Event bus (server-side)
# Use OPSLY_EVENT_BUS_URL for production, or NEXT_PUBLIC_OPSLY_EVENT_BUS_URL for local development
# OPSLY_EVENT_BUS_URL=http://orchestrator:3011/events
# Server-only on VPS (Docker network). Do not use localhost in production.
OPSLY_EVENT_BUS_URL=http://orchestrator:3011/events
# NEXT_PUBLIC_OPSLY_EVENT_BUS_URL — avoid; not reachable from browsers

# Supabase service role (server-side, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRM Integration (external CRM API)
# Webhook signature verification
CRM_WEBHOOK_SECRET=your-crm-webhook-secret-here
# CRM API configuration
NEXT_PUBLIC_CRM_API_URL=https://api.your-crm.com
CRM_API_KEY=your-crm-api-key
CRM_WORKSPACE_ID=your-workspace-id

# n8n Webhook Endpoints (for CRM sync + workflows)
# Account sync: POST .../webhooks/account-sync (CRM → Supabase)
# Deal tracking: Triggered by database polling (5-min interval)
# Follow-up reminder: POST .../webhook/intcloudsysops-followup
# Feedback digest: .../webhook/intcloudsysops-feedback-digest

# Public N8N webhook URL for CRM sync (Phase 2)
NEXT_PUBLIC_N8N_ACCOUNT_WEBHOOK=https://n8n-intcloudsysops.op-sly.com/webhook/intcloudsysops-account-sync

# Internal N8N Docker URL (for server-side operations)
N8N_WEBHOOK_BASE_URL=http://n8n-intcloudsysops:5678/webhook

# Inbound webhooks (n8n → Intcloudsysops app)
INTCLOUDSYSOPS_INBOUND_WEBHOOK_SECRET=
INTCLOUDSYSOPS_INBOUND_WEBHOOK_URL=https://intcloudsysops.op-sly.com/api/webhooks/inbound

# LLM Gateway (for AI-driven insights)
# Local dev only; VPS Doppler prd uses http://172.17.0.1:3010
LLM_GATEWAY_URL=http://127.0.0.1:3010

# Contact information for public-facing pages
NEXT_PUBLIC_INTCLOUDSYSOPS_CONTACT_EMAIL=support@intcloudsysops.com
NEXT_PUBLIC_INTCLOUDSYSOPS_SUPPORT_PHONE=+1234567890

# Firebase Admin (server) — NEVER commit service account JSON.
# Production: Doppler ops-intcloudsysops/prd → INTCLOUDSYSOPS_FIREBASE_ADMIN_JSON
# Local template: config/intcloudsysops-firebase-admin.json.example
INTCLOUDSYSOPS_FIREBASE_ADMIN_JSON=
