{
  "name": "@intcloudsysops/cloudops-portal",
  "version": "0.1.0",
  "private": true,
  "description": "CloudOps management portal (MVP). Next.js aligned with monorepo (15.5.x) for CRM integration and account management.",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "next lint",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:smoke": "node ../../node_modules/playwright/cli.js test e2e/release1-smoke.spec.ts",
    "analytics:snapshot": "python3 analytics/intcloudsysops_bi.py",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap sync && npx cap open ios",
    "cap:android": "npx cap sync && npx cap open android",
    "cap:android:build": "bash ../../scripts/intcloudsysops-cap-android.sh",
    "cap:android:studio": "bash ../../scripts/intcloudsysops-cap-android.sh --open",
    "cap:build": "next build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@intcloudsysops/openwa": "*",
    "@intcloudsysops/prompt-guard": "*",
    "@intcloudsysops/services": "*",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.106.0",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.1.8"
  }
}
