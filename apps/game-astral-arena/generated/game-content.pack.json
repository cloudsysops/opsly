          "prompt": "Combina hilo y escudo para despertar el Templo.",
          "kind": "create"
        }
      ]
    },
    {
      "id": "orion-earth-guardian-001",
      "title": "El que Encuentra lo Perdido",
      "summary": "Orion refuses to abandon trapped people and becomes the Earth Guardian.",
      "steps": [
        {
          "id": "read-orion-signal",
          "prompt": "Observa qué intenta mostrar Orion.",
          "kind": "explore"
        },
        {
          "id": "locate-survivors",
          "prompt": "Usa Visión del Nexo para localizar a los atrapados.",
          "kind": "explore"
        },
        {
          "id": "open-rescue-path",
          "prompt": "Conecta el hilo de Arena con la ruta segura de Brissa.",
          "kind": "connect"
        }
      ]
    },
    {
      "id": "aurora-magic-guardian-001",
      "title": "El Bosque sin Cielo",
      "summary": "The team discovers Aurora, the Astral Unicorn.",
      "steps": [
        {
          "id": "track-dark-lake",
          "prompt": "Sigue a Orion hasta el lago oculto.",
          "kind": "explore"
        },
        {
          "id": "listen-before-acting",
          "prompt": "Escucha antes de usar la fuerza.",
          "kind": "explore"
        },
        {
          "id": "light-path",
          "prompt": "Conecta el camino de luz de Aurora con los Hilos Astrales.",
          "kind": "connect"
        }
      ]
    },
    {
      "id": "nx7-awakening-001",
      "title": "El Robot que Recuerda",
      "summary": "The Guardians reactivate NX-7 and recover the first damaged record of Umbra.",
