{
  "name": "@intcloudsysops/ml",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./feedback-decision-engine": {
      "types": "./dist/src/feedback-decision-engine.d.ts",
      "import": "./dist/src/feedback-decision-engine.js",
      "default": "./dist/src/feedback-decision-engine.js"
    },
    "./feedback-decision-engine-runtime": {
      "types": "./dist/src/feedback-decision-engine.d.ts",
      "import": "./dist/src/feedback-decision-engine.js",
      "default": "./dist/src/feedback-decision-engine.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@intcloudsysops/llm-gateway": "^1.0.0",
    "@intcloudsysops/prompt-guard": "*",
    "@supabase/supabase-js": "^2.106.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
