{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@intcloudsysops/constants": ["../../lib/constants"],
      "@intcloudsysops/whatsapp": ["../../lib/whatsapp"],
      "@intcloudsysops/whatsapp/*": ["../../lib/whatsapp/*"],
      "@intcloudsysops/cloud-providers": ["../../lib/cloud-providers"],
      "@intcloudsysops/cloud-providers/*": ["../../lib/cloud-providers/*"],
      "@intcloudsysops/observability": ["../../lib/observability"],
      "@intcloudsysops/observability/*": ["../../lib/observability/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/__tests__/**", "vitest.config.ts"]
}
