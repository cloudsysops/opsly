{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@intcloudsysops/components": [
        "../../lib/components"
      ],
      "@intcloudsysops/components/*": [
        "../../lib/components/*"
      ],
      "@intcloudsysops/types": [
        "../../packages/types/src"
      ],
      "@intcloudsysops/types/*": [
        "../../packages/types/src/*"
      ],
      "@intcloudsysops/ml": [
        "../ml/src"
      ],
      "@intcloudsysops/ml/*": [
        "../ml/src/*"
      ],
      "@intcloudsysops/llm-gateway": [
        "../llm-gateway/src"
      ],
      "@intcloudsysops/llm-gateway/*": [
        "../llm-gateway/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}