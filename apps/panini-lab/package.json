{
  "name": "@intcloudsysops/panini-lab",
  "version": "0.1.0",
  "description": "BBC - AI Sticker Collection Assistant (Panini, World Cup, etc)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build && npm run build:server",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "node dist/server/index.js",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@supabase/supabase-js": "^2.38.0",
    "@intcloudsysops/voice-messaging": "workspace:*",
    "@intcloudsysops/errors": "workspace:*",
    "@intcloudsysops/config": "workspace:*",
    "@intcloudsysops/types": "workspace:*",
    "zod": "^3.22.4",
    "axios": "^1.6.0",
    "bull": "^4.11.0",
    "express": "^4.18.2",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "vitest": "^1.0.0",
    "playwright": "^1.40.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.1.0"
  }
}
