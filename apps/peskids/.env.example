NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origins used by auth redirect helpers and invite emails
NEXT_PUBLIC_PESKIDS_SITE_URL=http://localhost:3004
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002

NEXT_PUBLIC_TENANT_ID=peskids

# Admin dashboard authentication
DASHBOARD_ADMIN_SECRET=your-secure-admin-token

# Event bus (server-side)
# Use OPSLY_EVENT_BUS_URL for production, or NEXT_PUBLIC_OPSLY_EVENT_BUS_URL for local development
# OPSLY_EVENT_BUS_URL=http://orchestrator:3011/events
# Server-only on VPS (Docker network). Do not use localhost in production.
OPSLY_EVENT_BUS_URL=http://orchestrator:3011/events
# NEXT_PUBLIC_OPSLY_EVENT_BUS_URL — avoid; not reachable from browsers

# Supabase service role (server-side, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Jelou Integration (https://jelou.ai)
# Webhook signature verification
JELOU_WEBHOOK_SECRET=your-jelou-webhook-secret-here
# Workspace and form IDs for Jelou forms
NEXT_PUBLIC_JELOU_WORKSPACE_ID=your-workspace-id
NEXT_PUBLIC_JELOU_FORM_LEAD_ID=lead-capture-form-id
NEXT_PUBLIC_JELOU_FORM_FEEDBACK_ID=parent-feedback-form-id

# n8n Webhook Endpoints (for WhatsApp + Instagram centralization)
# Lead capture: POST .../webhooks/lead-capture (form → Supabase)
# Hot alert: Triggered by database polling (2-min interval)
# WhatsApp: POST .../webhook/peskids-whatsapp
# Instagram: POST .../webhook/peskids-instagram
# Pipeline notify: .../webhook/peskids-message-pipeline
# Send approved reply: .../webhook/peskids-send-approved

# Public N8N webhook URL for form submissions (Phase 2)
NEXT_PUBLIC_N8N_LEAD_WEBHOOK=https://n8n-peskids.op-sly.com/webhook/peskids-lead

# Internal N8N Docker URL (for server-side operations)
N8N_WEBHOOK_BASE_URL=http://n8n-peskids:5678/webhook

# WhatsApp reply mode: auto | draft
# auto = send WhatsApp replies automatically
# draft = generate and save drafts only
PESKIDS_WHATSAPP_REPLY_MODE=auto

# Inbound webhooks (n8n → Peskids app)
PESKIDS_INBOUND_WEBHOOK_SECRET=
PESKIDS_INBOUND_WEBHOOK_URL=https://peskids.op-sly.com/api/webhooks/inbound

# LLM Gateway (chat + borradores IA)
# Local dev only; VPS Doppler prd uses http://172.17.0.1:3010
LLM_GATEWAY_URL=http://127.0.0.1:3010

# Landing — miniaturas reales del feed (oEmbed). Copiar permalinks desde la app de Instagram.
# Perfil: https://www.instagram.com/peskidsnatacion/
# Ejemplo: INSTAGRAM_POST_PERMALINKS=https://www.instagram.com/p/ABC123/,https://www.instagram.com/reel/XYZ789/
INSTAGRAM_POST_PERMALINKS=

# Contacto web (WhatsApp wa.me — E.164 solo dígitos, sin +)
NEXT_PUBLIC_PESKIDS_WHATSAPP_E164=573000000000
NEXT_PUBLIC_PESKIDS_WHATSAPP_DISPLAY=+57 300 000 0000
NEXT_PUBLIC_PESKIDS_WHATSAPP_PREFILL=Hola Peskids, quiero información sobre clases de natación.
NEXT_PUBLIC_PESKIDS_CONTACT_EMAIL=hola@peskids.co

# CRM — Twenty (open source, self-hosted). Replaces GoHighLevel by default.
# TWENTY_API_URL=https://crm-peskids.op-sly.com
# TWENTY_API_KEY=
# PESKIDS_TWENTY_ENABLED=true
# TWENTY_DEFAULT_OPPORTUNITY_STAGE=NEW
# Peskids Pro 1.0 — stage slugs (PR-PRO-3 resolves real Twenty IDs; do not hardcode prod IDs):
# TWENTY_STAGE_NEW=
# TWENTY_STAGE_CONTACTED=
# TWENTY_STAGE_TRIAL_SCHEDULED=
# TWENTY_STAGE_TRIAL_COMPLETED=
# TWENTY_STAGE_ENROLLED=
# TWENTY_STAGE_LOST=

# Peskids Pro 1.0 feature flags (default OFF — document only in PR-PRO-0; wire in later PRs)
# PESKIDS_HOT_LEAD_ALERTS_ENABLED=false
# PESKIDS_DAILY_DIGEST_ENABLED=false
# PESKIDS_OPERATIONAL_NOTIFICATIONS_ENABLED=false
# PESKIDS_LEAD_CONFIRMATION_ENABLED=false
# PESKIDS_FAMILY_ACCESS_EMAIL_ENABLED=false
# PESKIDS_CONTACT_SLA_HOURS=48
# PESKIDS_EMAIL_FROM=
# PESKIDS_EMAIL_REPLY_TO=
# PESKIDS_LEAD_REMINDER_24H_ENABLED=false
# PESKIDS_LEAD_ESCALATION_48H_ENABLED=false
# PESKIDS_AUTO_CREATE_FOLLOWUP_ENABLED=false
# PESKIDS_TRIAL_REMINDER_ENABLED=false
# PESKIDS_ATTENDANCE_RISK_ALERT_ENABLED=false
# PESKIDS_ATTENDANCE_RISK_THRESHOLD=3
# PESKIDS_TIMEZONE=America/Bogota
# Unified provider flags (optional — unset = legacy dual-path, no prod change):
# PESKIDS_CRM_PROVIDER=ghl
# PESKIDS_INBOX_PROVIDER=wacrm
# PESKIDS_BOOKING_PROVIDER=ghl
# Future: twenty | espocrm | chatwoot | calcom
# wacrm WhatsApp inbox (enable runtime only after smoke):
# WACRM_PESKIDS_ENABLED=false
# WACRM_PESKIDS_SERVER_URL=https://wa-peskids.op-sly.com
# NEXT_PUBLIC_WACRM_PESKIDS_SERVER_URL=https://wa-peskids.op-sly.com
# WACRM_PESKIDS_WEBHOOK_SECRET=
# WACRM_PESKIDS_SYNC_TWENTY=notes-only
# PESKIDS_WACRM_WEBHOOK_SECRET=
# See docs/tenants/peskids/OPEN-SOURCE-CRM-MIGRATION.md
# Legacy GoHighLevel sidecar (opt-in only during migration):
# PESKIDS_GHL_ENABLED=false
# GOHIGHLEVEL_PESKIDS_API_KEY=

# FCM (server) — NUNCA commitear JSON de service account.
# Producción: Doppler ops-intcloudsysops/prd → PESKIDS_FIREBASE_ADMIN_JSON (JSON completo en una var).
# Plantilla local: config/peskids-firebase-admin.json.example (copiar fuera del repo o usar apps/peskids/.secrets/)
# Si existió config/peskids-firebase-admin.json en disco: rotar clave en Firebase Console y revocar la anterior.
PESKIDS_FIREBASE_ADMIN_JSON=
