      "export": "startValidationWorker",
      "queue": "openclaw",
      "jobName": "validate",
      "concurrency": 5,
      "envGate": "OPSLY_MAIA_WORKERS_ENABLED",
      "dependencies": [],
      "category": "maia-life-systems",
      "tags": ["validation", "ci", "quality"]
    },
    {
      "id": "maia-memory-writer",
      "name": "MemoryWriterWorker",
      "version": "1.0.0",
      "description": "Persiste estado en MAIA-STATUS.md vía GitHub API",
      "module": "../../apps/orchestrator/src/workers/MemoryWriterWorker.js",
      "export": "startMemoryWriterWorker",
      "queue": "openclaw",
      "jobName": "memory-write",
      "concurrency": 1,
      "envGate": "OPSLY_MAIA_WORKERS_ENABLED",
      "dependencies": ["maia-validation"],
      "category": "maia-life-systems",
      "tags": ["memory", "persistence", "status"]
    }
