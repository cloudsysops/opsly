{
  "version": "1.0.0",
  "description": "MAIA Plugin Registry — Workers autónomos auto-registrables",
  "plugins": [
    {
      "id": "maia-self-heal",
      "name": "SelfHealWorker",
      "version": "1.0.0",
      "description": "Reinicia y repara servicios en VPS vía SSH",
      "module": "../../apps/orchestrator/src/workers/SelfHealWorker.js",
      "export": "startSelfHealWorker",
      "queue": "openclaw",
      "jobName": "self-heal",
      "concurrency": 3,
      "envGate": "OPSLY_MAIA_WORKERS_ENABLED",
      "dependencies": [],
      "category": "maia-life-systems",
      "tags": ["self-heal", "vps", "ssh", "recovery"]
    },
    {
      "id": "maia-auto-deploy",
      "name": "AutoDeployWorker",
      "version": "1.0.0",
      "description": "Despliegue automático desde main branch",
      "module": "../../apps/orchestrator/src/workers/AutoDeployWorker.js",
      "export": "startAutoDeployWorker",
      "queue": "openclaw",
      "jobName": "auto-deploy",
      "concurrency": 1,
      "envGate": "OPSLY_MAIA_WORKERS_ENABLED",
      "dependencies": [],
      "category": "maia-life-systems",
      "tags": ["deploy", "ci-cd", "git"]
    },
    {
      "id": "maia-cost-gate",
      "name": "CostGateWorker",
      "version": "1.0.0",
      "description": "Control de presupuesto LLM por tenant",
      "module": "../../apps/orchestrator/src/workers/CostGateWorker.js",
      "export": "startCostGateWorker",
      "queue": "openclaw",
      "jobName": "cost-check",
      "concurrency": 20,
      "envGate": "OPSLY_MAIA_WORKERS_ENABLED",
      "dependencies": [],
      "category": "maia-life-systems",
      "tags": ["cost", "budget", "metering"]
    },
    {
      "id": "maia-claude-code",
      "name": "ClaudeCodeWorker",
      "version": "1.0.0",
