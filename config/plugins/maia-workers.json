      "export": "startClaudeCodeWorker",
      "queue": "openclaw",
      "jobName": "claude-code",
      "concurrency": 2,
      "envGate": "OPSLY_MAIA_WORKERS_ENABLED",
      "dependencies": [],
      "category": "maia-life-systems",
      "tags": ["claude", "llm", "code-generation"]
    },
    {
      "id": "maia-validation",
      "name": "ValidationWorker",
      "version": "1.0.0",
