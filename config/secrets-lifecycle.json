{
  "$schema_comment": "Metadata only — never store secret values here. Used by scripts/ops/check-secrets-expiry.sh. Include account_login + renew_url so Discord alerts say which console to open.",
  "version": 2,
  "owner": "operations",
  "notify": {
    "discord": true,
    "default_warn_days": [30, 14, 7, 1]
  },
  "secrets": [
    {
      "id": "tailscale-authkey-gha",
      "name": "TAILSCALE_AUTHKEY",
      "purpose": "GitHub Actions join Tailscale para SSH al VPS (Deploy / Deploy Peskids)",
      "stores": ["github:repo", "github:env:production"],
      "provider": "Tailscale",
      "account_label": "Tailscale · tailnet Opsly",
      "account_login": "cboteros (opsly-admin) — misma cuenta que administra el tailnet",
      "renew_url": "https://login.tailscale.com/admin/settings/keys",
      "renewal_cadence_days": 90,
      "created_on": "2026-08-05",
      "expires_on": "2026-11-03",
      "warn_days": [30, 14, 7, 1],
      "rotation_runbook": "docs/runbooks/SECRETS-KEY-MANAGEMENT.md#tailscale-authkey",
      "impact_if_expired": "Deploy Peskids / Deploy fallan en Connect Tailscale (invalid key)",
      "notes": "Cadencia fija 90 días. Tras rotar: actualizar repo + env production y expires_on (= created_on + 90)."
    },
    {
      "id": "ghcr-token-prd",
      "name": "GHCR_TOKEN",
      "purpose": "docker login ghcr.io en VPS / bootstrap",
      "stores": ["doppler:ops-intcloudsysops/prd"],
      "provider": "GitHub",
      "account_label": "GitHub · org cloudsysops",
      "account_login": "cuenta con acceso org cloudsysops (owner/admin típico: cboteros)",
      "renew_url": "https://github.com/settings/tokens",
      "renewal_cadence_days": 90,
      "created_on": null,
      "expires_on": null,
      "review_every_days": 90,
      "last_reviewed_on": "2026-08-05",
      "warn_days": [14, 7],
      "rotation_runbook": "docs/runbooks/SECRETS-KEY-MANAGEMENT.md#ghcr-token",
      "impact_if_expired": "Pull de imágenes GHCR denied en VPS"
    },
    {
      "id": "doppler-service-token-vps",
      "name": "DOPPLER_TOKEN (scope /opt/opsly)",
      "purpose": "doppler secrets download en VPS",
      "stores": ["vps:doppler-configure", "optional:github"],
      "provider": "Doppler",
      "account_label": "Doppler · proyecto ops-intcloudsysops",
      "account_login": "workspace Doppler IntCloud / Opsly (proyecto ops-intcloudsysops)",
      "renew_url": "https://dashboard.doppler.com/workplace",
      "renewal_cadence_days": 180,
      "created_on": null,
      "expires_on": null,
      "review_every_days": 180,
      "last_reviewed_on": "2026-08-05",
      "warn_days": [30, 14],
      "rotation_runbook": "docs/runbooks/SECRETS-KEY-MANAGEMENT.md#doppler-service-token",
      "impact_if_expired": "vps-bootstrap / deploy env refresh fallan"
    },
    {
      "id": "github-pat-ops",
      "name": "GITHUB_TOKEN / TOKEN_GH_OSPSLY",
      "purpose": "Automatismos n8n, GHCR auxiliar, scripts",
      "stores": ["doppler:ops-intcloudsysops/prd"],
      "provider": "GitHub",
      "account_label": "GitHub · org cloudsysops (PAT personal o fine-grained)",
      "account_login": "cuenta que creó el PAT en Doppler (revisar Doppler UI → secret comment)",
      "renew_url": "https://github.com/settings/tokens",
      "renewal_cadence_days": 90,
      "created_on": null,
      "expires_on": null,
      "review_every_days": 90,
      "last_reviewed_on": "2026-08-05",
      "warn_days": [14, 7],
      "rotation_runbook": "docs/runbooks/SECRETS-KEY-MANAGEMENT.md#github-pat",
      "impact_if_expired": "Workflows auxiliares / n8n GitHub integrations"
    },
    {
      "id": "discord-webhook-ops",
      "name": "DISCORD_WEBHOOK_URL",
      "purpose": "Alertas operativas (incluye avisos de caducidad de keys)",
      "stores": ["doppler:ops-intcloudsysops/prd", "optional:github"],
      "provider": "Discord",
      "account_label": "Discord · servidor Opsly (canal ops/alerts)",
      "account_login": "cuenta admin del servidor Discord Opsly",
      "renew_url": "https://discord.com/channels/@me",
      "renewal_cadence_days": 365,
      "created_on": null,
      "expires_on": null,
      "review_every_days": 365,
      "last_reviewed_on": "2026-08-05",
      "warn_days": [30],
      "rotation_runbook": "docs/runbooks/SECRETS-KEY-MANAGEMENT.md#discord-webhook",
      "impact_if_expired": "Silencio de alertas (incl. este chequeo)"
    },
    {
      "id": "resend-api-key",
      "name": "RESEND_API_KEY",
      "purpose": "Email invitaciones / capacity alerts",
      "stores": ["doppler:ops-intcloudsysops/prd"],
      "provider": "Resend",
      "account_label": "Resend · cuenta Opsly / IntCloud",
      "account_login": "cuenta Resend ligada al dominio de envío Opsly",
      "renew_url": "https://resend.com/api-keys",
      "renewal_cadence_days": 180,
      "created_on": null,
      "expires_on": null,
      "review_every_days": 180,
      "last_reviewed_on": "2026-08-05",
      "warn_days": [30, 14],
      "rotation_runbook": "docs/runbooks/SECRETS-KEY-MANAGEMENT.md#resend",
      "impact_if_expired": "POST /api/invitations y emails operativos fallan"
    },
    {
      "id": "cloudflare-dns-api",
      "name": "CF_DNS_API_TOKEN",
      "purpose": "Traefik ACME dnsChallenge",
      "stores": ["doppler:ops-intcloudsysops/prd"],
      "provider": "Cloudflare",
      "account_label": "Cloudflare · zona op-sly.com / dominio plataforma",
      "account_login": "cuenta Cloudflare dueña de la zona DNS Opsly",
      "renew_url": "https://dash.cloudflare.com/profile/api-tokens",
      "renewal_cadence_days": 180,
      "created_on": null,
      "expires_on": null,
      "review_every_days": 180,
      "last_reviewed_on": "2026-08-05",
      "warn_days": [30, 14],
      "rotation_runbook": "docs/runbooks/SECRET-ROTATION-AFTER-EXPOSURE.md",
      "impact_if_expired": "Renovación TLS Let's Encrypt falla"
    }
  ]
}
