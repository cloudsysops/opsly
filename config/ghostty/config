# Opsly — Ghostty profile (canonical copy in repo; install with scripts/install-ghostty-config.sh)
# Reload after edits: Cmd+Shift+,  |  Validate: ghostty +validate-config

# --- Workspace (agents and humans work under ~/opsly-workspace/opsly) ---
working-directory = ~/opsly-workspace/opsly
window-inherit-working-directory = false
command = /bin/zsh
shell-integration = detect

# --- Typography (JetBrains Mono if installed; falls back via font-family-fallback) ---
font-family = JetBrains Mono, Menlo, "SF Mono", Monaco
font-size = 13
font-thicken = true
adjust-cell-height = 2

# --- Theme (aligned with Opsly dark admin / terminal aesthetic) ---
theme = Catppuccin Mocha
window-theme = dark
macos-titlebar-style = transparent

# --- Window ---
background-opacity = 0.92
window-padding-x = 8
window-padding-y = 6
window-save-state = always
confirm-close-surface = false

# --- Scrollback / performance ---
scrollback-limit = 50000

# --- Tabs & splits (tmux-friendly; Ghostty splits when you need IDE-style layout) ---
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+comma=reload_config

# --- Quick terminal (optional; disable if it conflicts with Raycast/Hammerspoon) ---
# quick-terminal-position = top
