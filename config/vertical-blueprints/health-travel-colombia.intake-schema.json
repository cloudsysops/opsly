{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op-sly.com/schemas/health-travel-colombia.intake.schema.json",
  "title": "Health Travel Colombia Commercial Intake",
  "description": "Commercial and coordination intake only; not a clinical record. traveler_ref is optional at intake and may be assigned by the trusted backend after persistence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "traveler_name",
    "origin_country",
    "requested_service_category",
    "preferred_dates",
    "preferred_language",
    "consent_to_contact"
  ],
  "properties": {
    "traveler_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque internal traveler reference. Generated by the trusted backend when not supplied."
    },
    "traveler_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phone": {
      "type": "string",
      "minLength": 7,
      "maxLength": 32
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "origin_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "requested_service_category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "preferred_city": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "preferred_dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "earliest": {
          "type": ["string", "null"],
          "format": "date"
        },
        "latest": {
          "type": ["string", "null"],
          "format": "date"
        }
      },
      "anyOf": [
        { "required": ["earliest"] },
        { "required": ["latest"] }
      ]
    },
    "budget_range": {
      "type": ["object", "null"],
      "properties": {
        "min": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "max": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false
    },
    "companions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "preferred_language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "mobility_coordination": {
      "type": ["string", "null"],
      "maxLength": 500,
      "description": "Logistics/accessibility coordination only; do not include diagnoses or clinical history."
    },
    "consent_to_contact": {
      "const": true
    },
    "coordination_notes": {
      "type": ["string", "null"],
      "maxLength": 1000,
      "description": "Non-clinical coordination notes only."
    }
  },
  "anyOf": [
    { "required": ["phone"] },
    { "required": ["email"] }
  ],
  "not": {
    "anyOf": [
      { "required": ["diagnosis"] },
      { "required": ["medical_history"] },
      { "required": ["clinical_notes"] },
      { "required": ["prescription"] },
      { "required": ["prescriptions"] },
      { "required": ["lab_results"] },
      { "required": ["imaging"] },
      { "required": ["genetic_data"] },
      { "required": ["treatment_decision"] }
    ]
  }
}
