  "smoke_tests": [
    "twenty-crm-smoke for tenant",
    "wacrm-smoke when WACRM_*_ENABLED=true",
    "wacrm-twenty-hybrid-smoke combined"
  ],
  "next_commands": [
    "./scripts/provisioning/bootstrap-tenant.sh --launch clients/{tenant_slug}.launch.json --dry-run",
    "./scripts/tenants/bootstrap-wacrm.sh --slug {tenant_slug} --dry-run"
  ],
  "brand_basic": {
    "tone": "conversational, responsive, trust-building"
  }
}
