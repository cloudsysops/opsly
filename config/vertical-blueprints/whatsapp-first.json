{
  "vertical_blueprint_id": "whatsapp-first",
  "industry": "whatsapp-led service business",
  "offer_type": "discovery_chat",
  "lead_sources": ["website", "whatsapp", "instagram", "referral"],
  "form_fields": ["name", "phone", "email", "message"],
  "cta_text": "Escríbenos por WhatsApp",
  "landing_routes": ["/", "/contact"],
  "crm_pipeline_name": "Sales Pipeline",
  "pattern_ids": ["incubator-app", "crm-starter-stack", "whatsapp-first-stack"],
  "modules": ["lead-capture", "feedback-loop", "follow-up", "crm-view"],
  "n8n_workflows": [
    "lead-capture",
    "hot-lead-alert",
    "follow-up-reminder",
    "wacrm-inbound-twenty-note"
  ],
  "wacrm": {
    "enabled": false,
    "public_url": "https://wa-{tenant_slug}.op-sly.com",
    "sync_twenty": "notes-only",
