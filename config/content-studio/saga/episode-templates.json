{
  "version": 1,
  "updated_at": "2026-08-11",
  "format_rules": {
    "short": [
      "hook",
      "problem",
      "attempt",
      "learning",
      "closing_cta"
    ],
    "long_form": [
      "question",
      "context",
      "conflict",
      "discovery",
      "teaching",
      "resolution",
      "tease_next"
    ]
  },
  "templates": [
    {
      "id": "learning_short",
      "type": "youtube_short",
      "duration_sec": 30,
      "structure": [
        { "stage": "hook", "time": "0-2s", "goal": "grab attention" },
        { "stage": "problem", "time": "2-8s", "goal": "create tension" },
        { "stage": "value", "time": "8-20s", "goal": "teach something usable" },
        { "stage": "payoff", "time": "20-27s", "goal": "reveal the point" },
        { "stage": "cta", "time": "27-30s", "goal": "invite next step" }
      ],
      "must_include": ["one lesson", "one value", "one visual motif"],
      "use_for": ["bitsitos", "splashitos", "opsly_lore"]
    },
    {
      "id": "myth_episode",
      "type": "lore_episode",
      "duration_sec": 180,
      "structure": [
        { "stage": "question", "goal": "open with mystery" },
        { "stage": "world", "goal": "place the story in mundus/nexus/aether" },
        { "stage": "conflict", "goal": "show pressure or uncertainty" },
        { "stage": "insight", "goal": "connect symbol, number, or ancestor memory" },
        { "stage": "teaching", "goal": "leave a human lesson" },
        { "stage": "ending", "goal": "close with next-episode hook" }
      ],
      "must_include": ["symbol", "value", "character growth", "open loop"],
      "use_for": ["opsly_universe"]
    },
    {
      "id": "tenant_story_short",
      "type": "tenant_short",
      "duration_sec": 25,
      "structure": [
        { "stage": "hook", "goal": "tenant-specific attention" },
        { "stage": "demo", "goal": "show the skill or principle" },
        { "stage": "lesson", "goal": "make the takeaway explicit" },
        { "stage": "cta", "goal": "invite saving/sharing/practice" }
      ],
      "must_include": ["tenant branding", "practical action", "safe wording"],
      "use_for": ["peskids", "bitsitos", "future_tenants"]
    }
  ],
  "content_brief_schema": {
    "fields": [
      "tenant",
      "campaign",
      "pillar",
      "audience",
      "goal",
      "format",
      "hook",
      "insight",
      "key_message",
      "cta",
      "risks",
      "sources",
      "verification_needed"
    ]
  }
}
