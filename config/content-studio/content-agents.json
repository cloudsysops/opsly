{
  "version": 2,
  "updated_at": "2026-09-05",
  "mission": "ICSO YouTube Content Factory — Opsly + Bitsitos + Splashitos + Clicksitos + Opsly Universe (not Peskids)",
  "constraints": {
    "no_peskids_branding": true,
    "no_vps_heavy_daytime": true,
    "render_hosts": ["pc-gamer"],
    "mac_role": "enqueue + kit + 24x7 youtube publish",
    "publish": "24x7 next-unpublished unlisted, max 6/day (YouTube quota)",
    "brand_kit": "config/content-studio/brand-kit.json"
  },
  "visual_canon": {
    "opsly": {
      "studio_avatar": "docs/brand/icso/youtube/opsly-avatar.png",
      "studio_banner": "docs/brand/icso/youtube/opsly-banner.png",
      "use": "ICSO eye + hexagon for @opsly thumbnails and image_prompt. Never Universe kids boards as this channel avatar."
    },
    "opsly-universe": {
      "boards": [
        "docs/brand/icso/universe/guardianes-del-conocimiento.png",
        "docs/brand/icso/universe/play-learn-and-grow.png",
        "docs/brand/icso/universe/the-map-being-drawn.png",
        "docs/brand/icso/universe/the-map-unfolds.png",
        "docs/brand/icso/universe/atlas-parallel-universes.jpg"
      ],
      "use": "Character sheets, portals, Bitsitos/Splashitos islands. Approval required before publish."
    },
    "design_system": "docs/brand/icso/design-system/SKILL.md"
  },
  "agents": [
    {
      "id": "cursor-executor",
      "role": "enqueue_and_kit",
      "runtime": "mac",
      "tasks": [
        "check pc-gamer online",
        "enqueue content-video (mpt http://127.0.0.1:8080 on gamer)",
        "sync renders from gamer",
        "rebuild youtube-upload-kit",
        "24x7 publish next unpublished (--limit 1)"
      ],
      "commands": [
        "./scripts/content-factory-bootstrap.sh --gamer-up",
        "./scripts/ops/content-studio-sync-renders.sh",
        "./scripts/ops/content-studio-24x7.sh",
        "./scripts/content-studio-publish-youtube.sh --channel bitsitos --upload --limit 1"
      ]
    },
    {
      "id": "pc-gamer-gpu",
      "role": "content-video-worker",
      "runtime": "pc-gamer-wsl",
      "tasks": [
        "docker plane --with-content",
        "BullMQ queue content-video",
        "MoneyPrinter bridge GPU host :8080"
      ],
      "commands": [
        "./scripts/ops/pc-gamer-reconnect.sh --use-host-ollama --with-content",
        "./scripts/ops/pc-gamer-docker-plane.sh --up --use-host-ollama --with-content",
        "OPSLY_WORKER_ALLOWLIST=ollama,content-video"
      ],
      "requires": ["tailscale", "REDIS_URL in .env.worker"]
    },
    {
      "id": "hermes-planner",
      "role": "cadence_planner",
      "runtime": "mac-or-vps-queue",
      "tasks": [
        "rotate pillars edu / ent / sports / tech",
        "24x7 factory tick, max 6 uploads/day YouTube quota"
      ]
    },
    {
      "id": "human-publisher",
      "role": "oauth_and_studio",
      "runtime": "browser",
      "tasks": [
        "opslyquantum OAuth JSON in Doppler",
        "Studio @opsly: upload docs/brand/icso/youtube/opsly-avatar.png + opsly-banner.png",
        "Studio About: paste config/content-studio/channels/opsly/channel-about.txt",
        "Splashitos + Clicksitos channel ids when ready"
      ],
      "blocker_doc": "docs/brand/icso/OPSLYQUANTUM-YOUTUBE-SETUP.md"
    }
  ],
  "queues": {
    "content-video": {
      "worker": "ContentVideoWorker",
      "enqueue": "./scripts/content-studio-enqueue.sh --channel bitsitos",
      "mpt_base_url": "http://127.0.0.1:8080"
    }
  },
  "publish_order_today": [
    "bitsitos-015 education",
    "bitsitos-018 entertainment",
    "splashitos-008 sports",
    "bitsitos-001 tech",
    "bitsitos-long-001-edu when ready"
  ]
}
