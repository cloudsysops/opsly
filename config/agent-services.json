{
  "services": {
    "cursor": {
      "enabled": true,
      "url": "http://localhost:5001",
      "envUrl": "OPSLY_CURSOR_AGENT_URL",
      "type": "http",
      "timeoutMs": 60000,
      "retries": 1,
      "llmFallback": "deepseek_v4"
    },
    "claude": {
      "enabled": true,
      "url": "http://localhost:5002",
      "envUrl": "OPSLY_CLAUDE_AGENT_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 1,
      "llmFallback": "claude_haiku"
    },
    "llm_gateway": {
      "enabled": true,
      "url": "http://localhost:3010",
      "envUrl": "LLM_GATEWAY_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 2,
      "description": "LLM Gateway con proveedores gratuitos: Ollama, DeepSeek, NVIDIA, OpenRouter"
    },
    "copilot": {
      "enabled": false,
      "url": "http://localhost:5003",
      "envUrl": "OPSLY_COPILOT_AGENT_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 1
    },
    "opencode": {
      "enabled": false,
      "url": "http://localhost:5004",
      "envUrl": "OPSLY_OPENCODE_AGENT_URL",
