{
  "global_context_strategy": {
    "name": "brain-driven-optimization",
    "enabled": true,
    "description": "All agents use brain:research for 60-70% token savings",
    "mcp_tools_required": [
      "brain:research"
    ],
    "rule_hierarchy": [
      "1. Query exists in docs/brain/ → use brain:research",
      "2. Search code locally → grep/find",
      "3. Need architecture → AGENTS.md + VISION.md",
      "4. Last resort → ask user"
    ],
    "triggers_for_brain_research": [
      "investigar",
      "research",
      "explain",
      "explica",
      "¿cómo funciona",
      "how does",
      "funcionamiento"
    ],
    "onboarding_skills": [
      "opsly-context",
      "opsly-brain-researcher"
    ]
  },
  "services": {
    "cursor": {
      "enabled": true,
      "url": "http://localhost:5001",
      "envUrl": "OPSLY_CURSOR_AGENT_URL",
      "type": "http",
      "timeoutMs": 60000,
      "retries": 1,
      "llmFallback": "deepseek_v4"
    },
    "claude": {
      "enabled": true,
      "url": "http://localhost:5002",
      "envUrl": "OPSLY_CLAUDE_AGENT_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 1,
      "llmFallback": "claude_haiku"
    },
    "llm_gateway": {
      "enabled": true,
      "url": "http://localhost:3010",
      "envUrl": "LLM_GATEWAY_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 2,
      "description": "LLM Gateway con proveedores gratuitos: Ollama, DeepSeek, NVIDIA, OpenRouter"
    },
    "copilot": {
      "enabled": true,
      "url": "http://localhost:5003",
      "envUrl": "OPSLY_COPILOT_AGENT_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 1,
      "description": "copilot real local CLI bridge service"
    },
    "opencode": {
      "enabled": true,
      "url": "http://localhost:5004",
      "envUrl": "OPSLY_OPENCODE_AGENT_URL",
      "type": "http",
      "timeoutMs": 120000,
