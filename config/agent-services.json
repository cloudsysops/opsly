      "type": "http",
      "timeoutMs": 120000,
      "retries": 1
    },
    "hermes": {
      "enabled": false,
      "url": "http://localhost:5007",
      "envUrl": "OPSLY_HERMES_AGENT_URL",
      "type": "http",
      "timeoutMs": 120000,
      "retries": 1
    },
    "decepticon": {
      "enabled": false,
      "url": "http://localhost:5008",
      "envUrl": "OPSLY_DECEPTICON_AGENT_URL",
