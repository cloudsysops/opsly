{
  "version": 1,
  "mode": "inventory-first",
  "lanes": [
    "MERGE_READY",
    "BEHIND",
    "CONFLICTED",
    "CHECK_FAILED",
    "CHECK_PENDING",
    "REVIEW_BLOCKED",
    "SUPERSEDED",
    "PROTECTED",
    "UNKNOWN"
  ],
  "protected": {
    "patterns": [
      "peskids",
      "production",
      "n8n",
      "doppler",
      "dns",
      "traefik",
      "supabase/migrations/",
      "/migrations/",
      "apps/orchestrator/",
      "packages/agent-task-core/",
      "packages/git-branch-orchestrator/",
      "scripts/ops/github-agent-queue-submit.mjs",
      "infra/docker-compose",
      ".github/workflows/night-merge",
      ".github/workflows/production-change-window",
      ".github/workflows/validate-doppler",
      "scripts/ops/software-factory-safe-repair.mjs",
      "scripts/ops/lib/software-factory-repair-policy.mjs",
      "config/software-factory-repair-policy.json",
      ".github/workflows/"
    ],
    "allowAutoReconcile": false,
    "allowAutoMerge": false,
    "allowAutoDeploy": false
  },
  "merge": {
    "method": "squash",
    "requireExpectedHeadSha": true,
    "requireMergeable": true,
    "requireChecksGreen": true,
    "requireNoMaterialReviewBlockers": true,
    "autoMerge": false
  },
  "cleanup": {
    "deleteMergedBranches": "manual-or-supervised",
    "deleteSupersededBranches": "manual-or-supervised",
    "forceDelete": false
  }
}
