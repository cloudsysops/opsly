{
  "version": 2,
  "mode": "inventory-first",
  "lanes": [
    "MERGE_READY",
    "BEHIND",
    "CONFLICTED",
    "CHECK_FAILED",
    "CHECK_PENDING",
    "REVIEW_BLOCKED",
    "SUPERSEDED",
    "PROTECTED",
    "UNKNOWN"
  ],
  "protected": {
    "patterns": [
      "peskids",
      "production",
      "n8n",
      "doppler",
      "dns",
      "traefik",
      "supabase/migrations/",
      "/migrations/",
      "apps/orchestrator/",
      "packages/agent-task-core/",
      "packages/git-branch-orchestrator/",
      "scripts/ops/github-agent-queue-submit.mjs",
      "infra/docker-compose",
      ".github/workflows/night-merge",
      ".github/workflows/production-change-window",
      ".github/workflows/validate-doppler",
      "lib/agent-task-core/",
      "lib/git-branch-orchestrator/",
      "config/pr-reconciliation-policy.json",
      ".github/workflows/trusted-independent-review",
      "scripts/ci/check-independent-review.mjs",
      "lib/session-manager/",
      "lib/external-agent-registry/",
      "config/external-agent-registry.json",
      "apps/admin/app/mission-control/",
      "apps/admin/components/mission-control/",
      "apps/admin/lib/mission-control",
      "apps/api/app/api/admin/mission-control/",
      "scripts/ops/machine-claim.mjs",
      "scripts/ops/lib/machine-claim.mjs"
    ],
    "allowAutoReconcile": false,
    "allowAutoMerge": false,
    "allowAutoDeploy": false
  },
  "merge": {
    "method": "squash",
    "requireExpectedHeadSha": true,
    "requireMergeable": true,
    "requireChecksGreen": true,
    "requireNoMaterialReviewBlockers": true,
    "autoMerge": false
  },
  "cleanup": {
    "deleteMergedBranches": "manual-or-supervised",
    "deleteSupersededBranches": "manual-or-supervised",
    "forceDelete": false
  },
  "supervisor": {
    "mode": "parallel-lanes",
    "max_wip_per_conflict_key": 1,
    "shared_gate_probe_limit_per_sweep": 1,
    "no_progress_attempts_before_needs_human": 3,
    "continue_independent_work_when_shared_gate_blocked": true,
    "lanes": [
      {
        "id": "runtime",
        "conflict_key_prefix": "runtime/",
        "purpose": "physical/local compute recovery and acceptance"
      },
      {
        "id": "reviewer",
        "conflict_key_prefix": "review/",
        "purpose": "independent exact-head local review"
      },
      {
        "id": "reconciliation",
        "conflict_key_prefix": "pr-reconcile/",
        "purpose": "PR inventory, ordering and branch reconciliation"
      },
      {
        "id": "qa-evidence",
        "conflict_key_prefix": "qa/",
        "purpose": "non-production QA and evidence collection"
      }
    ],
    "shared_gates": {
      "independent_review": {
        "key": "independent-review-runtime",
        "behavior": "probe-one-per-sweep",
        "blocks": "merge-readiness-only",
        "must_not_block": [
          "technical-ci-repair",
          "runtime-recovery",
          "qa-evidence",
          "backlog-classification"
        ]
      }
    },
    "canonical_owners": {
      "dependency_planning": "TaskGraphV1",
      "task_ownership": "DispatchClaimV1/apps-orchestrator",
      "physical_machine_ownership": "PR #1616 machine-claim",
      "runtime_routing": "external-agent-registry + compute worker health",
      "zero_cost_execution": "PR #1686 local_opencode -> Ollama/Qwen",
      "independent_review": "Issue #1644 Open Review Agent",
      "pr_reconciliation": "PR reconciliation + PR Doctor",
      "physical_acceptance": "Issue #1191 / #1634 workpack #050",
      "mission_control": "Issue #1447 / factory-workstreams",
      "cleanup": "reconciliation cleanup plan",
      "telemetry": "Software Factory Telemetry / AgentTaskEnvelopeV1.request_id"
    }
  }
}
