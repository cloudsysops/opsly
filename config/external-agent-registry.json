{
  "version": 1,
  "updated_at": "2026-05-15",
  "principle": "Opsly orchestrates external market binaries only; no native duplicate agents.",
  "default_worker_id": "codex-cli",
  "routing_notes": {
    "architecture": "claude-code",
    "planning": "claude-code",
    "implementation": "opencode",
    "debugging": "codex-cli",
    "review": "hermes-cli",
    "security_review": "decepticon-cli",
    "tests": "playwright-runner",
    "assistant": "copilot-cli"
  },
  "workers": {
    "claude-code": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "claude",
      "opsly_job_type": "local_claude",
      "bridge_port": 5002,
      "endpoint_env": "OPSLY_CLAUDE_AGENT_URL",
      "default_model": "opsly:architect",
      "write_access": false,
      "risk_ceiling": "medium",
      "capabilities": ["architecture", "planning", "deep-review", "documentation"],
      "enabled": true
    },
    "opencode": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "opencode",
      "opsly_job_type": "local_opencode",
      "bridge_port": 5004,
      "endpoint_env": "OPSLY_OPENCODE_AGENT_URL",
      "default_model": "opsly:coding",
      "write_access": true,
      "risk_ceiling": "medium",
      "capabilities": ["code-edit", "repo-review", "tests", "implementation"],
      "enabled": true
    },
    "codex-cli": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "codex",
      "opsly_job_type": "local_codex",
      "bridge_port": 5005,
      "endpoint_env": "OPSLY_CODEX_AGENT_URL",
      "default_model": "opsly:coding",
      "write_access": true,
      "risk_ceiling": "high",
      "capabilities": ["implementation", "debugging", "refactors", "integration"],
      "enabled": true
    },
    "cursor-ide": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "cursor",
      "opsly_job_type": "local_cursor",
      "bridge_port": 5001,
      "endpoint_env": "OPSLY_CURSOR_AGENT_URL",
      "default_model": "opsly:fast",
      "write_access": true,
      "risk_ceiling": "medium",
      "capabilities": ["ide-assisted-edits", "prompt-queue"],
      "enabled": true
    },
    "copilot-cli": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "copilot",
      "opsly_job_type": "local_copilot",
      "bridge_port": 5003,
      "endpoint_env": "OPSLY_COPILOT_AGENT_URL",
      "default_model": "opsly:balanced",
      "write_access": false,
      "risk_ceiling": "low",
      "capabilities": ["assistant", "quick-explanations"],
      "enabled": true
    },
    "hermes-cli": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "hermes",
      "opsly_job_type": "local_hermes",
      "bridge_port": 5007,
      "endpoint_env": "OPSLY_HERMES_AGENT_URL",
      "default_model": "opsly:balanced",
      "write_access": false,
      "risk_ceiling": "medium",
      "capabilities": ["routing", "planning", "task-decomposition"],
      "enabled": true,
      "not_opsly_hermes_module": "apps/orchestrator/src/hermes is Opsly orchestration, not this CLI"
    },
    "decepticon-cli": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "codex",
      "opsly_job_type": "local_decepticon",
      "bridge_port": 5008,
      "endpoint_env": "OPSLY_DECEPTICON_AGENT_URL",
      "default_model": "opsly:quality",
      "write_access": false,
      "risk_ceiling": "high",
      "capabilities": ["security-review", "adversarial-audit"],
      "enabled": true
    },
    "aider-cli": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "aider",
      "opsly_job_type": "local_aider",
      "bridge_port": 5009,
      "endpoint_env": "OPSLY_AIDER_AGENT_URL",
      "default_model": "opsly:coding",
      "write_access": true,
      "risk_ceiling": "medium",
      "capabilities": ["git-aware-edits"],
      "enabled": true
    },
    "goose-cli": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "goose",
      "opsly_job_type": "local_goose",
      "bridge_port": 5010,
      "endpoint_env": "OPSLY_GOOSE_AGENT_URL",
      "default_model": "opsly:balanced",
      "write_access": true,
      "risk_ceiling": "medium",
      "capabilities": ["tool-use", "multi-step-automation"],
      "enabled": true
    },
    "playwright-runner": {
      "kind": "external-binary",
      "adapter": "agent-binary-http-bridge",
      "command": "playwright",
      "opsly_job_type": "local_playwright",
      "bridge_port": 5011,
      "endpoint_env": "OPSLY_PLAYWRIGHT_AGENT_URL",
      "default_model": "opsly:fast",
      "write_access": false,
      "risk_ceiling": "low",
      "capabilities": ["browser-smoke", "portal-e2e"],
      "enabled": true
    }
  }
}
