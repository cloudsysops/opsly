{
  "schema_version": "IndependentVerifierPolicyV1",
  "updated_at": "2026-09-14",
  "principle": "Builder and verifier are separate. Normal changes need one qualified verifier. Sensitive changes need two independent verifier groups. Missing evidence fails closed.",
