  "sensitive_surfaces": [
    {
      "id": "verifier-trust-chain",
      "patterns": [
        "scripts/ci/check-independent-review.mjs",
        "scripts/ci/lib/independent-verifier-policy.mjs",
        "scripts/ci/__tests__/qualified-independent-verifier.test.mjs",
        "config/independent-verifier-policy.json",
        ".github/workflows/trusted-independent-review.yml"
      ],
      "quorum": 2,
      "required_specialties": [
        "security",
        "ci"
      ]
    },
    {
      "id": "governance-and-autofix-policy",
      "patterns": [
        "config/pr-reconciliation-policy.json",
        "config/software-factory-repair-policy.json",
        "scripts/ops/software-factory-safe-repair.mjs",
        ".github/workflows/**"
      ],
      "quorum": 2,
      "required_specialties": [
        "ci",
        "blast-radius"
      ]
    },
    {
      "id": "auth-secrets-routing",
      "patterns": [
        "**/auth/**",
        "**/*auth*",
        "**/*secret*",
        "infra/**",
        "**/*traefik*",
        "**/*dns*"
      ],
      "quorum": 2,
      "required_specialties": [
        "security",
        "blast-radius"
      ]
    },
    {
      "id": "production-data-side-effects",
      "patterns": [
        "**/migrations/**",
        "**/*migration*",
        "**/n8n/**",
        "**/*n8n*",
        "apps/peskids/**"
      ],
      "quorum": 2,
      "required_specialties": [
        "security",
        "blast-radius"
      ]
    }
  ],
