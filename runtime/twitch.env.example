# DEPRECATED as a secret store.
# Use Doppler: project ops-intcloudsysops / config twitch
#
# One-time migrate (does not print values):
#   ./scripts/secrets/migrate-twitch-env-to-doppler.sh
#
# Run agent with secrets injected:
#   ./scripts/secrets/run-twitch-with-doppler.sh -- <command>
#
# Required secret NAMES in Doppler (values never in git):
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL_ID=
TWITCH_CHANNEL_LOGIN=
TWITCH_SCOPES="channel:manage:broadcast channel:read:stream_key chat:edit chat:read clips:edit user:read:email"
