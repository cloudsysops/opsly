# Plantilla de credenciales para el agente Twitch API de Opsly.
# Copiar a runtime/twitch.env (gitignored) y rellenar con valores reales.
# Ver docs/runbooks/STREAMING-GAMER-DJ-NDI.md para el flujo de obtención (OAuth authorization_code, redirect_uri=http://localhost:3000).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL_ID=
TWITCH_CHANNEL_LOGIN=
TWITCH_SCOPES="channel:manage:broadcast channel:read:stream_key chat:edit chat:read clips:edit user:read:email"
