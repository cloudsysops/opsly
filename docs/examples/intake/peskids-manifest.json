  "email_templates": [
    {
      "name": "Peskids — Welcome Parent",
      "trigger": "Contact Created",
      "subject": "¡Bienvenido a Peskids! Tu clase de prueba está aquí",
      "preview_text": "Aprende a nadar, diviértete y crece →",
      "content_type": "html",
      "language": "es"
    },
    {
      "name": "Peskids — Trial Confirmation",
      "trigger": "Appointment Scheduled (Trial Class calendar)",
      "subject": "Tu clase de prueba está confirmada",
      "preview_text": "{{appointment.date}} a las {{appointment.time}} →",
      "content_type": "html",
      "language": "es"
    }
  ],
  "sms_templates": [
    {
      "name": "Peskids — Trial Reminder",
      "trigger": "Time-based (24h before)",
      "content": "Hola {{contact.first_name}}, te recordamos tu clase de prueba mañana a las {{appointment.time}}. Lleva traje de baño y gorro. Confirma: {{confirmation_link}}"
    }
  ],
  "workflows": [
    {
      "name": "Welcome Parent",
      "trigger": "Contact Created",
      "actions": [
        {
          "type": "delay",
          "minutes": 2
        },
        {
          "type": "send_email",
          "template": "Peskids — Welcome Parent"
        },
        {
          "type": "add_tag",
          "tag": "lead-web"
        }
      ]
    },
    {
      "name": "Trial Confirmation",
      "trigger": "Appointment Scheduled (Trial Class calendar)",
      "actions": [
        {
          "type": "delay",
          "minutes": 1
        },
        {
          "type": "send_email",
          "template": "Peskids — Trial Confirmation"
        },
        {
          "type": "update_stage",
          "stage": "Trial Scheduled"
        },
        {
          "type": "add_tag",
          "tag": "trial-class"
        }
      ]
    },
    {
      "name": "Trial Reminder (24h before)",
      "trigger": "Time-based (24h before appointment)",
      "actions": [
        {
          "type": "send_sms",
          "template": "Peskids — Trial Reminder"
        },
        {
          "type": "add_tag",
          "tag": "trial-reminded"
        }
      ]
    },
    {
      "name": "No-Show Recovery",
      "trigger": "Appointment Status = No Show",
      "actions": [
        {
          "type": "delay",
          "minutes": 60
        },
        {
          "type": "send_sms",
          "content": "¡Nos perdimos en tu clase de prueba! ¿Hay algún problema? Podemos reagendar. Link: {{reschedule_link}}"
        },
        {
          "type": "create_task",
          "title": "Seguimiento: {{contact.name}}"
        },
        {
          "type": "add_tag",
          "tag": "no-show-recovery"
        }
      ]
    }
  ],
