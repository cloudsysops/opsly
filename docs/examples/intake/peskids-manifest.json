{
  "customer": "Peskids",
  "type": "Education (Trial-Based Enrollment Model)",
  "location_id": "KJ5LawrOOe3hIerqtMRu",
  "lead_sla_minutes": 2,
  "revenue_model": "Monthly subscription ($99/student, 150+ active = $14,850/month MRR)",
  "critical_automation": "Trial reminder (24h before) — <50% show rate without it = $1,500-2,500/month loss",
  "pipeline": {
    "name": "Peskids Enrollment",
    "description": "Student enrollment and trial class management",
    "stages": [
      {
        "name": "New Lead",
        "position": 1,
        "description": "Parent inquiry received"
      },
      {
        "name": "Contacted",
        "position": 2,
        "description": "Initial contact made with parent"
      },
      {
        "name": "Trial Scheduled",
        "position": 3,
        "description": "Trial class booked"
      },
      {
        "name": "Trial Completed",
        "position": 4,
        "description": "Child attended trial class"
      },
      {
        "name": "Enrolled",
        "position": 5,
        "description": "Parent completed enrollment & payment setup"
      },
      {
        "name": "Active Student",
        "position": 6,
        "description": "Student in active classes"
      }
    ]
  },
  "form": {
    "name": "Peskids Trial Registration",
    "description": "Capture parent & child info for trial class",
    "fields": [
      {
        "label": "Parent First Name",
        "type": "text",
        "required": true
      },
      {
        "label": "Parent Last Name",
        "type": "text",
        "required": true
      },
      {
        "label": "Parent Email",
        "type": "email",
        "required": true
      },
      {
        "label": "Parent Phone",
        "type": "phone",
        "required": true
      },
      {
        "label": "Child First Name",
        "type": "text",
        "required": true
      },
      {
        "label": "Child Age",
        "type": "number",
        "required": true,
        "min": 3,
        "max": 18
      },
      {
        "label": "Interest Level",
        "type": "dropdown",
        "required": false,
        "options": [
          "Very interested",
          "Somewhat interested",
          "Just exploring"
        ]
      }
    ],
    "post_submission_redirect": "calendar_booking_link"
  },
  "calendars": [
    {
      "name": "Trial Class",
      "duration_minutes": 45,
      "timezone": "America/Bogota",
      "working_hours": {
        "start": "09:00",
        "end": "18:00",
        "days": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]
      },
      "description": "Trial swimming class slots"
    },
    {
      "name": "Assessment",
      "duration_minutes": 30,
      "timezone": "America/Bogota",
      "working_hours": {
        "start": "08:00",
        "end": "19:00",
        "days": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]
      },
      "description": "Swimming level assessment"
    }
  ],
  "tags_to_create": [
    {
      "name": "trial-class",
      "description": "Trial class scheduled"
    },
    {
      "name": "trial-reminded",
      "description": "Trial reminder sent (24h before)"
