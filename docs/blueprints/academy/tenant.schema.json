{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsly.io/schemas/academy-tenant.schema.json",
  "title": "Opsly Academy Tenant Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_slug",
    "business_name",
    "country",
    "timezone",
    "primary_email",
    "crm_provider",
    "capabilities",
    "roles"
  ],
  "properties": {
    "tenant_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "business_name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "primary_email": {
      "type": "string",
      "format": "email"
    },
    "crm_provider": {
      "const": "twenty"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "academy.people",
          "academy.scheduling",
          "academy.enrollment",
          "academy.engagement",
          "academy.forms",
          "academy.messaging",
          "academy.payments",
          "academy.dashboard"
        ]
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["admin", "teacher", "family"]
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "twenty": {
          "$ref": "#/$defs/integrationToggle"
        },
        "n8n": {
          "$ref": "#/$defs/integrationToggle"
        },
        "wacrm": {
          "$ref": "#/$defs/integrationToggle"
        },
        "wompi": {
          "$ref": "#/$defs/integrationToggle"
        }
      }
    },
    "approval_boundary": {
      "type": "string",
      "enum": ["approval-first", "read-only"],
      "default": "approval-first"
    },
    "executive_agent_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "integrationToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
