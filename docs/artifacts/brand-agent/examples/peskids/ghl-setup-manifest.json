          "fieldType": "checkbox",
          "required": true,
          "validation": "must be checked"
        }
      ],
      "successMessage": "Thank you. We received your request and will follow up shortly."
    }
  ],
  "workflowsChecklist": [
    {
      "name": "Lead Intake",
      "trigger": "Form submitted",
      "actions": [
        "Create opportunity",
        "Assign tag",
        "Send welcome SMS",
        "Send welcome email",
        "Notify team"
      ],
      "implementation": "manual",
      "notes": "Build in GHL or snapshot because workflow authoring is not automated here."
    },
    {
      "name": "Trial Reminder",
      "trigger": "Trial class booking",
      "actions": [
        "24h reminder",
        "3h reminder",
        "30min reminder"
      ],
      "implementation": "manual",
      "notes": "Time-based reminder sequence."
    },
    {
      "name": "Post Trial Follow Up",
      "trigger": "Trial class completed",
      "actions": [
        "Request feedback",
        "Share enrollment offer",
        "Continue follow-up"
      ],
      "implementation": "manual",
      "notes": "Keep the sequence human and short."
    },
    {
      "name": "Enrollment Success",
      "trigger": "Student enrolled",
      "actions": [
        "Move stage",
        "Tag active student",
        "Send welcome email",
        "Notify team"
      ],
      "implementation": "manual",
      "notes": "Mark the lead as active and stop reminder flows."
    }
  ],
