{
  "clientKey": "peskids",
  "companyName": "Peskids",
  "shortName": "Peskids",
  "setupTemplate": "academy",
  "pipelineName": "Academy Growth Pipeline",
  "pipelineStages": [
    {
      "name": "New Lead",
      "description": "Fresh parent or student inquiry captured from a form or conversation.",
      "objective": "Register the lead and start the follow-up sequence.",
      "entryCriteria": [
        "Form submitted",
        "Inbound inquiry received",
        "Lead imported"
      ],
      "exitCriteria": [
        "Contact created",
        "Tag assigned",
        "Opportunity opened"
      ]
    },
    {
      "name": "Contacted",
      "description": "Team has acknowledged the lead and started the first follow-up.",
      "objective": "Move the lead into an active conversation.",
      "entryCriteria": [
        "Welcome message sent",
        "Follow-up task created"
      ],
      "exitCriteria": [
        "Reply received",
        "Trial class interest confirmed"
      ]
    },
    {
      "name": "Interested",
      "description": "Parent or student has shown clear intent to book a class.",
      "objective": "Convert interest into a scheduled trial.",
      "entryCriteria": [
        "Interest confirmed",
        "Schedule request received"
      ],
      "exitCriteria": [
        "Trial class booked"
      ]
    },
    {
      "name": "Trial Class Scheduled",
      "description": "Trial class has been booked on the calendar.",
      "objective": "Prepare reminders and attendance.",
      "entryCriteria": [
        "Calendar booking completed"
      ],
      "exitCriteria": [
        "Trial reminder workflow active",
        "Calendar event confirmed"
      ]
    },
    {
      "name": "Trial Class Completed",
      "description": "Trial class happened and feedback should be collected.",
      "objective": "Collect feedback and push the enrollment offer.",
      "entryCriteria": [
        "Trial session completed"
      ],
      "exitCriteria": [
        "Feedback sent",
        "Enrollment follow-up started"
      ]
    },
    {
      "name": "Enrollment Pending",
      "description": "The family is evaluating the offer after the trial.",
      "objective": "Nudge toward conversion without pressure.",
      "entryCriteria": [
        "Trial completed",
        "Enrollment proposal shared"
      ],
      "exitCriteria": [
        "Enrollment accepted",
        "Lost marked"
      ]
    },
    {
      "name": "Active Student",
      "description": "Student is enrolled and attending classes.",
      "objective": "Track active revenue and retention.",
      "entryCriteria": [
        "Enrollment confirmed",
        "Payment or registration complete"
      ],
      "exitCriteria": [
        "Student paused",
        "Renewal needed"
      ]
    },
    {
      "name": "Lost",
      "description": "Lead did not convert or stopped engaging.",
      "objective": "Close the loop and record the reason.",
      "entryCriteria": [
        "No response",
        "Not interested",
        "Declined offer"
      ],
      "exitCriteria": [
        "Archived",
        "Re-engagement list updated"
      ]
    }
  ],
