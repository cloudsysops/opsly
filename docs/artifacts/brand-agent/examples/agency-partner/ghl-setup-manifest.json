{
  "clientKey": "agency-partner",
  "companyName": "Marketing Agency Partner",
  "shortName": "Partner",
  "setupTemplate": "partner",
  "pipelineName": "Partner Growth Pipeline",
  "pipelineStages": [
    {
      "name": "New Lead",
      "description": "New inbound inquiry from a partner prospect.",
      "objective": "Capture and route the lead quickly.",
      "entryCriteria": [
        "Form submitted",
        "Inbound call",
        "Referral received"
      ],
      "exitCriteria": [
        "Contact created",
        "Opportunity opened"
      ]
    },
    {
      "name": "Qualified",
      "description": "Partner fit and budget have been validated.",
      "objective": "Move into discovery scheduling.",
      "entryCriteria": [
        "Need confirmed",
        "Decision maker identified"
      ],
      "exitCriteria": [
        "Discovery booked"
      ]
    },
    {
      "name": "Discovery Scheduled",
      "description": "Discovery call is on the calendar.",
      "objective": "Prepare the team and reminder flow.",
      "entryCriteria": [
        "Calendar booking completed"
      ],
      "exitCriteria": [
        "Discovery completed"
      ]
    },
    {
      "name": "Proposal Sent",
      "description": "Proposal and scope have been delivered.",
      "objective": "Nudge toward close.",
      "entryCriteria": [
        "Discovery complete",
        "Offer agreed"
      ],
      "exitCriteria": [
        "Won",
        "Lost"
      ]
    },
    {
      "name": "Won",
      "description": "Partner has agreed to proceed.",
      "objective": "Trigger onboarding and implementation.",
      "entryCriteria": [
        "Proposal approved",
        "Payment or authorization received"
      ],
      "exitCriteria": [
        "Onboarding completed"
      ]
    },
    {
      "name": "Onboarding",
      "description": "Implementation is underway.",
      "objective": "Collect assets and complete setup.",
      "entryCriteria": [
        "Kickoff completed"
      ],
      "exitCriteria": [
        "Active"
      ]
    },
    {
      "name": "Active",
      "description": "The partner is live and operating.",
      "objective": "Track delivery and outcomes.",
      "entryCriteria": [
        "Setup complete"
      ],
      "exitCriteria": [
        "Renewal",
        "Churn"
      ]
    },
    {
      "name": "Lost",
      "description": "Prospect did not convert or paused the deal.",
      "objective": "Close and record the reason.",
      "entryCriteria": [
        "No response",
        "Budget mismatch",
        "Not a fit"
      ],
      "exitCriteria": [
        "Archived"
      ]
    }
  ],
