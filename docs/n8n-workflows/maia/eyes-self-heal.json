{
  "name": "Opsly Eyes — Self-Heal Edge / Peskids",
  "description": "Detecta Cloudflare 521 / health fail y dispara SelfHealWorker (edge-recover) + fallback local",
  "nodes": [
    {
      "name": "Schedule: cada 3 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 3 }] }
      }
    },
    {
      "name": "GET health Peskids",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "https://www.peskids.com/api/health",
        "method": "GET",
        "timeout": 10000,
        "continueOnFail": true
      }
    },
    {
      "name": "GET health API",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.op-sly.com/api/health",
        "method": "GET",
        "timeout": 10000,
        "continueOnFail": true
      }
    },
    {
      "name": "Filter: edge caído",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.status !== 'ok' }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "name": "POST orchestrator: edge-recover",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "http://opsly_orchestrator:3011/api/maia/self-heal",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_slug: 'peskids', service: 'edge', action: 'edge-recover', reason: 'n8n_eyes_health_fail' }) }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ]
}
