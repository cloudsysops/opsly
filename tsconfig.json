{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "paths": {
      "@lib/prompts": ["./lib/prompts"],
      "@lib/prompts/*": ["./lib/prompts/*"],
      "@lib/observability": ["./lib/observability"],
      "@lib/observability/*": ["./lib/observability/*"],
      "@lib/components": ["./lib/components"],
      "@lib/components/*": ["./lib/components/*"],
      "@lib/evaluation": ["./lib/evaluation"],
      "@lib/evaluation/*": ["./lib/evaluation/*"],
      "@intcloudsysops/prompts": ["./lib/prompts"],
      "@intcloudsysops/prompts/*": ["./lib/prompts/*"],
      "@intcloudsysops/observability": ["./lib/observability"],
      "@intcloudsysops/observability/*": ["./lib/observability/*"],
      "@intcloudsysops/components": ["./lib/components"],
      "@intcloudsysops/components/*": ["./lib/components/*"],
      "@intcloudsysops/evaluation": ["./lib/evaluation"],
      "@intcloudsysops/evaluation/*": ["./lib/evaluation/*"],
      "@intcloudsysops/types": ["./packages/types/src"],
      "@intcloudsysops/types/*": ["./packages/types/src/*"],
      "@intcloudsysops/api": ["./lib/api"],
      "@intcloudsysops/api/*": ["./lib/api/*"],
      "@intcloudsysops/config": ["./lib/config"],
      "@intcloudsysops/config/*": ["./lib/config/*"],
      "@intcloudsysops/errors": ["./lib/errors"],
      "@intcloudsysops/errors/*": ["./lib/errors/*"],
      "@intcloudsysops/external-agent-registry": ["./lib/external-agent-registry"],
      "@intcloudsysops/external-agent-registry/*": ["./lib/external-agent-registry/*"],
      "@intcloudsysops/git-branch-orchestrator": ["./lib/git-branch-orchestrator"],
      "@intcloudsysops/git-branch-orchestrator/*": ["./lib/git-branch-orchestrator/*"],
      "@intcloudsysops/migrations": ["./lib/migrations"],
      "@intcloudsysops/migrations/*": ["./lib/migrations/*"],
      "@intcloudsysops/security": ["./lib/security"],
      "@intcloudsysops/security/*": ["./lib/security/*"],
      "@intcloudsysops/services": ["./lib/services"],
      "@intcloudsysops/services/*": ["./lib/services/*"],
      "@intcloudsysops/session-manager": ["./lib/session-manager"],
      "@intcloudsysops/session-manager/*": ["./lib/session-manager/*"],
      "@intcloudsysops/telemetry": ["./lib/telemetry"],
      "@intcloudsysops/telemetry/*": ["./lib/telemetry/*"],
      "@intcloudsysops/testing": ["./lib/testing"],
      "@intcloudsysops/testing/*": ["./lib/testing/*"],
      "@intcloudsysops/workflow": ["./lib/workflow"],
      "@intcloudsysops/workflow/*": ["./lib/workflow/*"],
      "@intcloudsysops/runtime": ["./lib/runtime"],
      "@intcloudsysops/runtime/*": ["./lib/runtime/*"],
      "@intcloudsysops/ml": ["./apps/ml/src"],
      "@intcloudsysops/ml/*": ["./apps/ml/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "lib/**/*", "apps/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
