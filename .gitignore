# Git worktrees (isolated development)
.worktrees/

# USB kit: overrides locales (SSH Host, etc.)
tools/usb-kit/pen.local.json
# Cifrados age de emergencia (.env, SSH, PAT) — nunca al repo
tools/usb-kit/secrets/

# Nunca commitear secretos locales derivados del config
config/opsly.secrets.json
config/doppler-ready.json
config/failover-monitor.env
config/gcp.env
config/worker-tailscale.env
infra/gcp-failover-info.json
# Worker Linux opslyquantum — env local del stack Docker (secretos)
infra/opslyquantum.env
# Obsidian local (infra vault)
infra/.obsidian/graph.json
infra/Untitled.base
infra/Untitled.canvas

# Agent context (no secrets)
context/doppler-ready.json
tools/agents/prompts/secrets-*.md

# Cursor / entorno local
.cursor/mcp.json
.cursor/responses/
.cursor/hooks/logs/
.cursor/.validation/
.cursor/.ipc/
.cursor/.metadata.json
.cursor/prompts/.metadata.json
# Overrides personales de reglas Cursor (el canónico del repo sigue siendo opsly.mdc, etc.)
.cursor/rules/*.local.mdc

# OpenCode — ajustes por máquina (modelo, preferencias). El repo puede llevar .opencode.json base;
# si lo editas solo para ti, renombra/copia a este nombre o usa skip-worktree en .opencode.json.
.opencode.local.json

# Obsidian — estado de UI en la raíz del repo (no es el vault docs/); no commitear
.obsidian/
.env.local
.env*.local
!.env.local-workers.example
.env.worker
**/.write_test

# package.json / package-lock.json: del monorepo; no ignorar. Cambios de deps menores → stash,
# commit aparte, o rama; no añadir aquí.

node_modules
apps/api/coverage/
apps/orchestrator/coverage/
.next
.env*
!.env.example
*.tsbuildinfo
dist
.turbo

# --- Terraform (infra/terraform/) ---
# .terraform/ — plugins y metadata del proveedor (regenerable con terraform init).
# terraform.tfstate / *.backup — estado con IDs y a veces datos sensibles; por máquina.
# *.tfvars — suele usarse para secretos locales; no commitear (usar TF_VAR_* / Doppler).
# .terraform.lock.hcl — NO ignorar: fija versiones del proveedor; debe versionarse en git.
.terraform/
terraform.tfstate
terraform.tfstate.backup
*.tfvars
infra/terraform/tfplan

# Raíz: nunca `logs/` aquí (structure-guard + usar runtime/logs/)
/logs/

# Runtime directories (VPS/local runtime)
runtime/logs/*
runtime/letsencrypt/*
runtime/tenants/*
runtime/pids/*
!runtime/pids/.gitkeep
!runtime/logs/.gitkeep
!runtime/letsencrypt/.gitkeep
!runtime/tenants/.gitkeep

# Supabase CLI local link metadata (regenerable)
supabase/.temp/
supabase/migrations/supabase/.temp/

# Playwright (apps/portal)
apps/portal/test-results/
apps/portal/playwright-report/

# Obsidian — ignore runtime/personal state (vault en docs/)
docs/.obsidian/cache
docs/.obsidian/workspace
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/graph.json
docs/.obsidian/plugins/recent-files-obsidian/data.json

# Keep config + plugin settings tracked
!docs/.obsidian/app.json
!docs/.obsidian/vault.json
!docs/.obsidian/core-plugins.json
!docs/.obsidian/community-plugins.json
!docs/.obsidian/templates/
!docs/.obsidian/hotkeys.json
!docs/.obsidian/file-index.json
!docs/.obsidian/plugins/obsidian-git/data.json

# Claude local config (ignored)
.claude/settings.local.json
.claude/2-context-management/CLAUDE.local.md

# Claude Code worktrees (local clones; never commit)
.claude/worktrees/

# Redis dump file
dump.rdb
logs/

# Agent bootstrap state (generated per-agent, local to session)
.agent-bootstrap-state/
.aider*
tenants/
.aider.chat.history.md
