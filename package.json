{
  "name": "intcloudsysops",
  "private": true,
  "packageManager": "npm@10.8.3",
  "dependencies": {
    "dompurify": "3.4.11",
    "js-tiktoken": "^1.0.21",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "workspaces": [
    "apps/*",
    "apps/notebooklm-agent",
    "lib/*",
    "packages/skills/manifest",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:check": "turbo lint --continue",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check",
    "update-state": "node scripts/update-state.js",
    "sync-agents": "bash scripts/update-agents.sh",
    "validate-context": "python3 -m json.tool context/system_state.json > /dev/null",
    "validate-openapi": "node scripts/ci/validate-openapi.mjs",
    "validate-structure": "node scripts/validate-structure.js",
    "validate:strict": "npm run validate-structure",
    "validate:strict:ci": "npm run validate-structure",
    "index-knowledge": "bash scripts/index-knowledge.sh",
    "obsidian:file-index": "node scripts/update-obsidian-file-index.mjs",
    "obsidian:sync": "bash scripts/obsidian-ide-sync.sh",
    "obsidian:check": "npm run obsidian:file-index && npm run validate-structure",
    "sigma:install": "bash scripts/install-sigma-rules.sh",
    "sigma:smoke": "bash scripts/sigma-harness-smoke.sh",
    "validate-skills": "npm run validate-skills --prefix packages/skills/manifest",
    "test-skills-manifest": "npm test --prefix packages/skills/manifest",
    "skills:list": "node scripts/load-skills.js list",
    "skills:bootstrap": "node scripts/load-skills.js bootstrap",
    "skills:sync:external": "bash scripts/sync-skills-external.sh",
    "knowledge:archive:ingest": "node scripts/archive-to-obsidian.mjs",
    "knowledge:archive:ingest:all": "bash scripts/archive-ingest-all-domains.sh",
    "agents:hooks:bootstrap:internal": "bash scripts/agent-hooks.sh bootstrap --mode internal",
    "agents:hooks:bootstrap:external": "bash scripts/agent-hooks.sh bootstrap --mode external",
    "agents:hooks:post-commit": "bash scripts/agent-hooks.sh post-commit",
    "opsly:ensure-ollama": "bash scripts/ensure-ollama-local.sh",
    "opsly:vps-ssh:ensure-key": "bash scripts/vps-ssh-ensure-key.sh",
    "opsly:vps-ssh:verify": "bash scripts/vps-ssh-verify.sh",
    "opsly:vps-ssh:bootstrap": "bash scripts/vps-ssh-bootstrap-from-admin.sh",
    "opsly:vps-ssh:to-admin": "bash scripts/setup-vps-ssh-to-opsly-admin.sh",
    "opsly:tailscale:routes": "python3 scripts/opsly_tailscale_cli.py routes",
    "opsly:tailscale:ping": "python3 scripts/opsly_tailscale_cli.py ping-vps",
    "opsly:tailscale:hook-once": "python3 scripts/opsly_tailscale_cli.py agent-stop-hook",
    "opsly:vps:housekeeping": "bash scripts/vps-docker-housekeeping.sh",
    "opsly:vps:housekeeping:dry-run": "bash scripts/vps-docker-housekeeping.sh --dry-run --auto",
    "opsly:drive:ensure-layout": "python3 scripts/opsly_drive_automation.py ensure-layout",
    "opsly:drive:upload-tenant-onboarding": "python3 scripts/opsly_drive_automation.py upload-tenant-pack",
    "opsly:chat": "python3 tools/cli/main.py chat",
    "opsly:openclaw-cli": "bash scripts/openclaw-with-node22.sh",
    "client:setup": "tsx scripts/client-setup.ts",
    "client:plan": "tsx scripts/client-plan.ts",
    "test": "turbo run test",
    "test:unit": "npm run test --workspace=@intcloudsysops/api && npm run test --workspace=@intcloudsysops/portal && npm run test --workspace=@intcloudsysops/mcp && npm run test --workspace=@intcloudsysops/ml && npm run test --workspace=@intcloudsysops/llm-gateway -- --exclude __tests__/cache-namespace.test.ts",
    "test:integration": "REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6379} npm run test --workspace=@intcloudsysops/orchestrator && REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6379} npm run test --workspace=@intcloudsysops/llm-gateway -- __tests__/cache-namespace.test.ts",
    "test:coverage": "turbo run test -- --coverage",
    "test:e2e": "turbo run test:e2e",
    "dev:notion-mcp": "doppler run --project ops-intcloudsysops --config prd -- npm run dev --workspace=@intcloudsysops/notion-mcp",
    "start:notion-mcp": "doppler run --project ops-intcloudsysops --config prd -- npm run start --workspace=@intcloudsysops/notion-mcp",
    "enqueue-test-job": "tsx --tsconfig scripts/tsconfig.enqueue.json scripts/enqueue-test-job.ts",
    "ghl-provision": "tsx scripts/ghl-provision.ts",
    "ghl-provision:intcloudsysops": "bash scripts/ghl-provision-intcloudsysops.sh",
    "ghl-provision:peskids": "bash scripts/ghl-provision-peskids.sh",
    "ghl:scope-smoke": "bash scripts/ghl-scope-smoke.sh",
    "ghl:reprovision-all": "bash scripts/ghl-reprovision-all.sh",
    "ghl:agency-auto-provision": "bash scripts/ghl-agency-auto-provision.sh --watch",
    "opsly:local-prompt-watcher": "tsx scripts/local-prompt-watcher.ts",
    "opsly:local-prompt-watcher:once": "tsx scripts/local-prompt-watcher.ts --once",
    "opsly:agent-cli": "tsx scripts/opsly-agent-cli.ts",
    "opsly:cursor-session-brief": "tsx --tsconfig scripts/tsconfig.cursor-sdk.json scripts/cursor-sdk-session-brief.ts",
    "opsly:local-cursor-service": "tsx scripts/cursor-agent-service.ts --port 5001",
    "opsly:local-cli-agent-service": "tsx scripts/cli-agent-service.ts",
    "opsly:local-claude-service": "OPSLY_CLI_AGENT=claude PORT=5002 tsx scripts/cli-agent-service.ts",
    "opsly:local-copilot-service": "OPSLY_CLI_AGENT=copilot PORT=5003 tsx scripts/cli-agent-service.ts",
    "opsly:local-opencode-service": "OPSLY_CLI_AGENT=opencode PORT=5004 tsx scripts/cli-agent-service.ts",
    "opsly:local-codex-service": "OPSLY_CLI_AGENT=codex PORT=5005 tsx scripts/cli-agent-service.ts",
    "opsly:local-openai-service": "OPSLY_CLI_AGENT=openai PORT=5006 tsx scripts/cli-agent-service.ts",
    "opsly:local-hermes-service": "OPSLY_CLI_AGENT=hermes PORT=5007 tsx scripts/cli-agent-service.ts",
    "opsly:local-decepticon-service": "OPSLY_CLI_AGENT=decepticon PORT=5008 tsx scripts/cli-agent-service.ts",
    "opsly:local-aider-service": "OPSLY_CLI_AGENT=aider PORT=5009 tsx scripts/cli-agent-service.ts",
    "opsly:local-goose-service": "OPSLY_CLI_AGENT=goose PORT=5010 tsx scripts/cli-agent-service.ts",
    "opsly:local-playwright-service": "OPSLY_CLI_AGENT=playwright PORT=5011 tsx scripts/cli-agent-service.ts",
    "opsly:ghostty:install-config": "bash scripts/install-ghostty-config.sh",
    "opsly:ghostty:open": "bash scripts/local-ghostty-open.sh",
    "docs:sync": "node scripts/sync-docs.js && node scripts/generate-sprint-tracking.js && node scripts/generate-agents-assignments.js",
    "docs:watch": "nodemon --watch docs/implementation/status.yaml --exec \"npm run docs:sync\"",
    "test:docs": "bash scripts/test-sync-docs.sh",
    "notion:fetch": "node scripts/notion-to-yaml.js",
    "notion:push": "node scripts/yaml-to-notion.js",
    "notion:sync": "npm run notion:fetch && npm run docs:sync",
    "notion:validate": "node scripts/validate-notion-schema.js",
    "github:sync-issues": "node scripts/notion-to-github-issues.js",
    "sprint:burndown": "node scripts/update-sprint-burndown.js",
    "agents:status": "node scripts/generate-agents-assignments.js && (command -v cat >/dev/null && cat docs/AGENTS-ASSIGNMENTS.md || true)",
    "test:notion": "bash scripts/test-notion.sh",
    "evolution:run": "node apps/experimental/ai-evolution-archive/src/index.js",
    "evolution:analyze": "node apps/experimental/ai-evolution-archive/src/index.js analyze",
    "evolution:plan": "node apps/experimental/ai-evolution-archive/src/index.js plan",
    "evolution:implement": "node apps/experimental/ai-evolution-archive/src/index.js implement",
    "evolution:validate": "node apps/experimental/ai-evolution-archive/src/index.js validate",
    "evolution:deploy": "node apps/experimental/ai-evolution-archive/src/index.js deploy",
    "evolution:feedback": "node apps/experimental/ai-evolution-archive/src/index.js feedback",
    "evolution:full": "npm run evolution:analyze && npm run evolution:plan && npm run evolution:validate && npm run evolution:deploy",
    "sync:all": "npm run docs:sync && node scripts/sync-all-orchestrator.js",
    "hermes:tick": "npm run hermes --workspace=@intcloudsysops/orchestrator -- tick",
    "hermes:status": "npm run hermes --workspace=@intcloudsysops/orchestrator -- status",
    "hermes:test": "npm run test:hermes --workspace=@intcloudsysops/orchestrator",
    "docs:code-snapshots": "node scripts/generate-code-snapshots.mjs",
    "docs:to-notebooklm": "node scripts/docs-to-notebooklm.mjs",
    "notebooklm:sync": "npm run docs:code-snapshots && npm run docs:to-notebooklm",
    "notebooklm:query": "node scripts/query-notebooklm.mjs",
    "skills:to-notebooklm": "node scripts/skills-to-notebooklm.mjs",
    "notebooklm:full-sync": "npm run notebooklm:sync && npm run skills:to-notebooklm",
    "layer:url": "bash scripts/get-layer-url.sh",
    "layer:tests": "bash scripts/run-layer-tests.sh",
    "layer:deploy": "bash scripts/deploy-layer.sh",
    "peskids:cap:android": "bash scripts/peskids-cap-android.sh",
    "peskids:cap:android:open": "bash scripts/peskids-cap-android.sh --open",
    "superagents:install": "bash scripts/install-superagents-stack.sh",
    "superagents:up": "bash scripts/superagents-up.sh",
    "superagents:doctor": "bash scripts/superagents-doctor.sh",
    "runtime:detect": "npm run detect --workspace=@intcloudsysops/runtime",
    "runtime:setup": "bash scripts/runtime-setup-wizard.sh",
    "validate-local-runtime": "bash scripts/validate-local-runtime.sh",
    "opsly:git-sync": "bash scripts/git-sync-repo.sh",
    "opsly:repos:status": "bash scripts/opsly-repo-align.sh --status",
    "opsly:repos:align": "bash scripts/opsly-repo-align.sh --local --vps --branch main --vps-reset",
    "postinstall": "npm run build -w @intcloudsysops/content-studio && npm run build -w @intcloudsysops/pattern-catalog && npm run build -w @intcloudsysops/sigma-harness",
    "prepare": "husky",
    "commit": "git-cz",
    "patterns:install": "bash scripts/install-patterns.sh --with-sigma",
    "patterns:validate": "bash scripts/install-patterns.sh",
    "patterns:list": "bash scripts/list-patterns.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cursor/sdk": "^1.0.13",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.12",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "bullmq": "^5.58.5",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-xml-builder": "1.2.0",
    "hono": "4.12.26",
    "husky": "^9.1.7",
    "ip-address": "10.2.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "twilio": "^4.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.sh": [
      "bash -n"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.2",
    "@rollup/rollup-darwin-x64": "4.60.2",
    "@rollup/rollup-linux-x64-gnu": "4.60.2"
  },
  "overrides": {
    "rollup": "4.60.2",
    "postcss": "8.5.13",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8",
    "tmp": "0.2.7",
    "uuid": "^14.0.0",
    "fast-uri": "3.1.2",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": {
      "fast-xml-builder": "1.2.0"
    },
    "hono": "4.12.26",
    "ip-address": "10.2.0",
    "express-rate-limit": {
      "ip-address": "10.2.0"
    },
    "@tootallnate/once": "^3.0.1",
    "langsmith": "0.7.1",
    "glob": "10.5.0",
    "eslint-config-next": "15.5.18",
    "@next/eslint-plugin-next": "15.5.18",
    "@supabase/supabase-js": "^2.106.0",
    "@supabase/ssr": "^0.6.1",
    "vitest": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "tar": "^7.5.15",
    "undici": "7.28.0",
    "dompurify": "3.4.11",
    "mermaid": "^11.4.0",
    "next": "15.5.18",
    "qs": "6.15.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "peskids": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
