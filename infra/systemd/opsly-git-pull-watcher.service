[Unit]
Description=Opsly git-pull watcher — despierta al agente local cuando hay commits nuevos en origin (VPS)
Documentation=file:///opt/opsly/docs/01-development/GIT-PULL-WATCHER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vps-dragon
Group=vps-dragon
WorkingDirectory=/opt/opsly
Environment=REPO_ROOT=/opt/opsly
Environment=POLL_SEC=60
Environment=WATCH_BRANCH=main
ExecStart=/bin/bash /opt/opsly/scripts/git-pull-watcher.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
