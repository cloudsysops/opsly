[Unit]
Description=Opsly host disk+RAM alert (Discord)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/opsly
Environment=OPSLY_ROOT=/opt/opsly
EnvironmentFile=-/opt/opsly/.env
# disk-alert covers disk; monitor-tenants --local-host covers RAM when run via tenant timer.
# This unit runs disk-alert alone for denser disk cadence.
ExecStart=/opt/opsly/scripts/disk-alert.sh
Nice=10

[Install]
WantedBy=multi-user.target
