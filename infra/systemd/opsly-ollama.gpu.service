# Ollama local CON passthrough de GPU NVIDIA (solo hosts con GPU real, p. ej. PC-gamer).
# Variante de opsly-ollama.service — usar esta en vez de esa cuando el host
# tiene GPU NVIDIA + NVIDIA Container Toolkit instalado (`nvidia-smi` debe
# funcionar antes de instalar esto). Ver infra/docker-compose.opslyquantum.gpu.yml.
#
# Instalación (worker Linux con GPU, usuario opslyquantum en grupo docker):
#   sudo cp infra/systemd/opsly-ollama.gpu.service /etc/systemd/system/opsly-ollama.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now opsly-ollama
#
# Ajusta rutas si el clon no está en /home/opslyquantum/opsly.
# Opcional: copiar infra/opslyquantum.env.example → infra/opslyquantum.env

[Unit]
Description=Opsly Ollama local con GPU NVIDIA (Docker)
Documentation=https://github.com/cloudsysops/opsly
After=docker.service network-online.target
Wants=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=opslyquantum
Group=opslyquantum
SupplementaryGroups=docker
WorkingDirectory=/home/opslyquantum/opsly
Environment=OLLAMA_GPU=1

ExecStart=/bin/bash -c 'if [ -f /home/opslyquantum/opsly/infra/opslyquantum.env ]; then exec docker compose -f /home/opslyquantum/opsly/infra/docker-compose.opslyquantum.yml -f /home/opslyquantum/opsly/infra/docker-compose.opslyquantum.gpu.yml --env-file /home/opslyquantum/opsly/infra/opslyquantum.env up -d ollama; else exec docker compose -f /home/opslyquantum/opsly/infra/docker-compose.opslyquantum.yml -f /home/opslyquantum/opsly/infra/docker-compose.opslyquantum.gpu.yml up -d ollama; fi'

ExecStop=/usr/bin/docker compose -f /home/opslyquantum/opsly/infra/docker-compose.opslyquantum.yml -f /home/opslyquantum/opsly/infra/docker-compose.opslyquantum.gpu.yml stop ollama
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
