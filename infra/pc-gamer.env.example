# Copiar a .env.worker en la raíz del repo en PC-gamer (gitignored).
#   cp infra/pc-gamer.env.example .env.worker
#
# REDIS_URL: desde Mac con Doppler (nunca pegar secretos en chat):
#   doppler secrets get REDIS_PASSWORD --project ops-intcloudsysops --config prd --plain
#   # montar: redis://default:<PASSWORD>@100.120.151.91:6379/0
#
# Nodo EFÍMERO — prohibido en este archivo:
#   DOPPLER_* / AWS_* / GCP_* / SUPABASE_SERVICE_ROLE_KEY / STRIPE_* /
#   PLATFORM_ADMIN_TOKEN / GITHUB_TOKEN / GHCR_TOKEN / claves SSH productivas
# Validar: ./scripts/ops/assert-ephemeral-worker-env.sh

WORKER_ID=pc-gamer-openclaw-01
OPSLY_EPHEMERAL_WORKER=true
OPSLY_ORCHESTRATOR_ROLE=worker
OPSLY_ORCHESTRATOR_MODE=worker-enabled

# Solo jobs seguros best-effort (GPU / trainer). No self-heal / deploy / notify prod.
OPSLY_WORKER_ALLOWLIST=ollama
OPSLY_OLLAMA_DIRECT=true

# Obligatorio — broker BullMQ del VPS por Tailscale (no hostname docker "redis")
REDIS_URL=redis://default:CHANGE_ME@100.120.151.91:6379/0

# LLM Gateway en VPS — opcional para jobs ollama en nodo efímero.
# Con OPSLY_EPHEMERAL_WORKER=true + OLLAMA_URL, OllamaWorker llama Ollama LOCAL directo (margen $0).
LLM_GATEWAY_URL=http://100.120.151.91:3010
ORCHESTRATOR_LLM_GATEWAY_URL=http://100.120.151.91:3010

# Ollama local en este host. Obligatorio para money path efímero.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ORIGINS=*
# OPSLY_OLLAMA_DIRECT=true

# Concurrencia baja (máquina compartida / gaming)
WORKER_CONCURRENCY_OLLAMA=1

# Heartbeat (opcional; cron cada 1 min)
# OPSLY_WORKER_HEARTBEAT_TTL_SEC=180
