# Copiar a .env.worker en la raíz del repo en PC-gamer (gitignored).
#   cp infra/pc-gamer.env.example .env.worker
# Rellenar REDIS_URL desde Doppler prd (nunca commitear).
#
#   doppler secrets get REDIS_URL --project ops-intcloudsysops --config prd --plain

WORKER_ID=pc-gamer-openclaw-01
OPSLY_ORCHESTRATOR_ROLE=worker
OPSLY_ORCHESTRATOR_MODE=worker-enabled

# Obligatorio — misma cola que el VPS (Tailscale), no Redis local
REDIS_URL=redis://:CHANGE_ME@100.120.151.91:6379

# LLM Gateway en VPS (control plane)
LLM_GATEWAY_URL=http://100.120.151.91:3010
ORCHESTRATOR_LLM_GATEWAY_URL=http://100.120.151.91:3010

# Ollama local en este host (GPU)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ORIGINS=*

# Concurrencia (ajustar si juegas / carga alta)
WORKER_CONCURRENCY_CURSOR=1
WORKER_CONCURRENCY_OLLAMA=2
WORKER_CONCURRENCY_N8N=1
WORKER_CONCURRENCY_NOTIFY=2
