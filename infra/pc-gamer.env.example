# Copiar a .env.worker en la raíz del repo en PC-gamer (gitignored).
#   cp infra/pc-gamer.env.example .env.worker
#
# REDIS_URL: desde Mac con Doppler (nunca pegar secretos en chat):
#   doppler secrets get REDIS_PASSWORD --project ops-intcloudsysops --config prd --plain
#   # montar: redis://default:<PASSWORD>@100.120.151.91:6379/0
#
# Nodo EFÍMERO — prohibido en este archivo:
#   DOPPLER_* / AWS_* / GCP_* / SUPABASE_SERVICE_ROLE_KEY / STRIPE_* /
#   PLATFORM_ADMIN_TOKEN / GITHUB_TOKEN / GHCR_TOKEN / claves SSH productivas
# Validar: ./scripts/ops/assert-ephemeral-worker-env.sh

# Identidad ÚNICA por nodo — OBLIGATORIO cambiar en cada máquina.
# El heartbeat y el check-pc-gamer escriben/leen opsly:worker:heartbeat:${WORKER_ID};
# si dos nodos usan el mismo ID, se tapan el pulso entre sí en Redis.
# El ID debe coincidir con config/compute-workers.json (fuente canónica del scheduler).
# Para scripts/setup-compute-worker.sh usa OPSLY_WORKER_ID=<mismo-id>; ese valor
# de bootstrap y WORKER_ID en .env.worker deben ser idénticos.
#   desktop-smdqcia (WSL2, RTX 3060) -> home-gpu-01
#   pc-gamer (Windows, RTX 5070 Ti)  -> pc-gamer-openclaw-01
#   desktop-smdqcia-1                -> desktop-smdqcia-1
#   pc-gamer-openclaw-01-wsl         -> pc-gamer-openclaw-01-wsl
WORKER_ID=@WORKER_ID@
OPSLY_EPHEMERAL_WORKER=true
OPSLY_ORCHESTRATOR_ROLE=worker
OPSLY_ORCHESTRATOR_MODE=worker-enabled

# Solo jobs seguros best-effort (GPU / trainer / content). No self-heal / deploy / notify prod.
# Overnight OpenCode: ollama,local-agents (vía pc-gamer-opencode-plane.sh --up)
# Splashitos / Content Studio Shorts: ollama,content-video
OPSLY_WORKER_ALLOWLIST=ollama,content-video
OPSLY_OLLAMA_DIRECT=true
# MoneyPrinter bridge en este host (compose moneyprinter o node scripts/moneyprinter-bridge.mjs)
MONEY_PRINTER_TURBO_URL=http://127.0.0.1:8080
# MONEY_PRINTER_TURBO_API_KEY=
MPT_BRIDGE_PUBLIC_BASE=http://127.0.0.1:8080
OPSLY_LOCAL_AGENT_UNIFIED_ONLY=true
OPSLY_OPENCODE_AGENT_URL=http://127.0.0.1:5004
# Token SOLO local bridge↔worker (genera el plano OpenCode). NO es PLATFORM_ADMIN_TOKEN.
# OPSLY_CLI_AGENT_TOKEN=

# Obligatorio — broker BullMQ del VPS por Tailscale (no hostname docker "redis")
REDIS_URL=redis://default:CHANGE_ME@100.120.151.91:6379/0

# LLM Gateway en VPS — opcional para jobs ollama en nodo efímero.
# Con OPSLY_EPHEMERAL_WORKER=true + OLLAMA_URL, OllamaWorker llama Ollama LOCAL directo (margen $0).
LLM_GATEWAY_URL=http://100.120.151.91:3010
ORCHESTRATOR_LLM_GATEWAY_URL=http://100.120.151.91:3010

# Ollama local en este host. Obligatorio para money path efímero.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ORIGINS=*
# OPSLY_OLLAMA_DIRECT=true

# Concurrencia baja (máquina compartida / gaming)
WORKER_CONCURRENCY_OLLAMA=1

# Heartbeat (opcional; cron cada 1 min). Payload is JSON: GPU/VRAM/disk/jobs.
# OPSLY_WORKER_HEARTBEAT_TTL_SEC=180
# WORKER_VRAM_GB=16
# WORKER_VERSION=1
