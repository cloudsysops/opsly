{
  "name": "MAIA Ojos — Health Radar",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } },
      "id": "maia-ojos-cron",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.OPSLY_API_URL || 'http://app:3000'}}/api/health",
        "responseFormat": "json"
      },
      "id": "maia-ojos-health",
      "name": "Check Opsly API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [240, 0]
    },
    {
      "parameters": { "mode": "passThrough" },
      "id": "maia-ojos-report",
      "name": "Report health signal",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Every 15 minutes": { "main": [[{ "node": "Check Opsly API", "type": "main", "index": 0 }]] },
    "Check Opsly API": { "main": [[{ "node": "Report health signal", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
