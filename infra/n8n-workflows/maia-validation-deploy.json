{
  "name": "Maia Life Systems - Validation Deploy",
  "nodes": [
    {
      "parameters": {
        "path": "maia/validate-deploy",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "id": "maia-validation-webhook",
      "name": "Validation Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OPSLY_ORCHESTRATOR_URL || 'http://orchestrator:3011'}}/queue/openclaw",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'maia.validation', payload: $json, tenant_slug: $json.tenant_slug, request_id: $json.request_id }) }}"
      },
      "id": "maia-validation-dispatch",
      "name": "Dispatch Validation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OPSLY_ORCHESTRATOR_URL || 'http://orchestrator:3011'}}/queue/openclaw",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'maia.auto_deploy', payload: $json, tenant_slug: $json.tenant_slug, request_id: $json.request_id }) }}"
      },
      "id": "maia-deploy-dispatch",
      "name": "Dispatch Auto Deploy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Validation Webhook": { "main": [[{ "node": "Dispatch Validation", "type": "main", "index": 0 }]] },
    "Dispatch Validation": { "main": [[{ "node": "Dispatch Auto Deploy", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["maia", "life-systems", "validation", "deploy"]
}
