{
  "name": "Maia Life Systems - Self Heal",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "maia-self-heal-schedule",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "service", "name": "service", "value": "platform", "type": "string" },
            { "id": "health_url", "name": "health_url", "value": "={{$env.OPSLY_API_HEALTH_URL || 'https://api.' + $env.PLATFORM_DOMAIN + '/api/health'}}", "type": "string" },
            { "id": "tenant_slug", "name": "tenant_slug", "value": "platform", "type": "string" }
          ]
        }
      },
      "id": "maia-self-heal-payload",
      "name": "Build Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OPSLY_ORCHESTRATOR_URL || 'http://orchestrator:3011'}}/queue/openclaw",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'maia.self_heal', payload: $json, tenant_slug: $json.tenant_slug, request_id: $execution.id }) }}"
      },
      "id": "maia-self-heal-dispatch",
      "name": "Dispatch Self Heal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Every 5 Minutes": { "main": [[{ "node": "Build Payload", "type": "main", "index": 0 }]] },
    "Build Payload": { "main": [[{ "node": "Dispatch Self Heal", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["maia", "life-systems", "self-heal"]
}
