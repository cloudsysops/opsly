{
  "name": "Peskids WhatsApp Approval & Send",
  "nodes": [
    {
      "parameters": {
        "resource": "query",
        "query": "SELECT * FROM whatsapp_outbox WHERE tenant_id = 'peskids' AND status = 'approved' AND sent_at IS NULL ORDER BY approved_at ASC LIMIT 100",
        "nodeCredentialType": "postgres"
      },
      "name": "Get Approved Messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": {
        "postgres": "=peskids_supabase"
      }
    },
    {
      "parameters": {
        "resource": "query",
        "query": "UPDATE whatsapp_outbox SET status = 'sending', updated_at = NOW() WHERE id = '{{$item.json.id}}' RETURNING *",
        "nodeCredentialType": "postgres"
      },
      "name": "Mark Sending",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "postgres": "=peskids_supabase"
      }
    },
    {
      "parameters": {
        "url": "={{$env[\"WACRM_BASE_URL\"]}}/messages/send",
        "authentication": "genericCredentialType",
        "genericCredentialType": "=wacrm_auth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "{{$env[\"WACRM_API_KEY\"]}}"
            }
          ]
        },
        "method": "POST",
        "contentType": "application/json",
        "body": "{\n  \"recipientType\": \"individual\",\n  \"recipients\": [\"{{$item.json.phone_number}}\" ],\n  \"type\": \"{{$item.json.message_type}}\",\n  \"message\": {\n    \"text\": \"{{$item.json.body}}\"\n  }\n}"
      },
      "name": "Send via WACRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "comparator": "equals",
              "value1": "={{$node[\"Send via WACRM\"].json[\"statusCode\"]}}",
              "value2": 200
            }
          ]
        }
      },
      "name": "Send Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "resource": "query",
        "query": "UPDATE whatsapp_outbox SET status = 'sent', sent_at = NOW(), external_message_id = '{{$node[\"Send via WACRM\"].json[\"messageId\"]}}', updated_at = NOW() WHERE id = '{{$item.json.id}}' RETURNING *",
        "nodeCredentialType": "postgres"
      },
      "name": "Mark Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1050, 200],
      "credentials": {
        "postgres": "=peskids_supabase"
      }
    },
    {
      "parameters": {
        "resource": "query",
        "query": "UPDATE whatsapp_outbox SET status = 'failed', failed_at = NOW(), error_code = '{{$node[\"Send via WACRM\"].json[\"errorCode\"]}}', error_message = '{{$node[\"Send via WACRM\"].json[\"message\"]}}', updated_at = NOW() WHERE id = '{{$item.json.id}}' RETURNING *",
        "nodeCredentialType": "postgres"
      },
      "name": "Mark Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1050, 400],
      "credentials": {
        "postgres": "=peskids_supabase"
      }
    },
    {
      "parameters": {
        "url": "={{$env[\"SLACK_WEBHOOK_URL\"]}}",
        "method": "POST",
        "contentType": "application/json",
        "body": "{\n  \"text\": \"WhatsApp Send Failed\",\n  \"blocks\": [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Message Send Failed*\\n Phone: {{$item.json.phone_number}}\\n Error: {{$node['Send via WACRM'].json['message']}}\"\n      }\n    }\n  ]\n}"
      },
      "name": "Alert Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 400]
    }
  ],
  "connections": {
    "Get Approved Messages": {
      "main": [
        [
          {
            "node": "Mark Sending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Sending": {
      "main": [
        [
          {
            "node": "Send via WACRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send via WACRM": {
      "main": [
        [
          {
            "node": "Send Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Success?": {
      "main": [
        [
          {
            "node": "Mark Sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Failed": {
      "main": [
        [
          {
            "node": "Alert Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0",
  "meta": {
    "instanceId": "peskids",
    "description": "Process approved messages from whatsapp_outbox and send via WACRM with error handling"
  }
}
