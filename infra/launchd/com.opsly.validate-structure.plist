<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opsly.validate-structure</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "__OPSLY_ROOT__" &amp;&amp; npm run validate-structure --silent</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__OPSLY_ROOT__</string>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__OPSLY_ROOT__/runtime/logs/launchd/validate-structure.out.log</string>
  <key>StandardErrorPath</key>
  <string>__OPSLY_ROOT__/runtime/logs/launchd/validate-structure.err.log</string>
</dict>
</plist>
