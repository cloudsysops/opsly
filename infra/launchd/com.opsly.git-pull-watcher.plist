<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opsly.git-pull-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__OPSLY_ROOT__/scripts/git-pull-watcher.sh</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__OPSLY_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REPO_ROOT</key>
    <string>__OPSLY_ROOT__</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__OPSLY_ROOT__/runtime/logs/launchd-git-pull-watcher.out</string>
  <key>StandardErrorPath</key>
  <string>__OPSLY_ROOT__/runtime/logs/launchd-git-pull-watcher.err</string>
</dict>
</plist>
