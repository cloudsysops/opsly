# Imagen opsly-hermes: worker Hermes (BullMQ) + health HTTP, con runtime Python/Playwright para notebooklm-py (ADR-014).
# El entrypoint no ejecuta apps/orchestrator/dist/index.js (evita duplicar el resto de workers).
# Builder alineado a apps/orchestrator/Dockerfile (#360): npm ci con workspaces lib/* enlazados.

FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
COPY turbo.json ./
COPY tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY lib ./lib
COPY scripts ./scripts
COPY config ./config
RUN npm ci --ignore-scripts

RUN npm run build -w @intcloudsysops/types \
  && npm run build -w @intcloudsysops/universe \
  && npm run build -w @intcloudsysops/content-studio \
  && npm run build -w @intcloudsysops/pattern-catalog \
  && npm run build -w @intcloudsysops/sigma-harness \
  && npm run build -w @intcloudsysops/prompt-guard \
  && npm run build -w @intcloudsysops/llm-gateway \
  && npm run build -w @intcloudsysops/ml \
  && npm run build -w @intcloudsysops/external-agent-registry \
  && npm run build -w @intcloudsysops/agent-task-core \
  && npm run build -w @intcloudsysops/git-branch-orchestrator \
  && npm run build -w @intcloudsysops/session-manager \
  && npm run build -w @intcloudsysops/runtime \
  && npm run build -w @intcloudsysops/voice-messaging \
  && npm run build -w @intcloudsysops/notebooklm-agent \
  && npm run build -w @intcloudsysops/orchestrator

FROM node:20-alpine AS runner

ENV NODE_ENV=production
ENV ORCHESTRATOR_HEALTH_PORT=3020

# Python para notebooklm-py (NotebookLM agent) - playwright se instala via npx en runtime si se necesita
RUN apk add --no-cache \
    python3 \
    py3-pip \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-dejavu \
    curl \
  && python3 -m pip install --no-cache-dir --break-system-packages \
    "notebooklm-py>=0.2.0,<0.3"

WORKDIR /app
# Mismo patrón que apps/orchestrator/Dockerfile: node_modules completo del builder evita MODULE_NOT_FOUND
# (@intcloudsysops/llm-gateway, ml, types, etc.) al cargar apps/orchestrator/dist desde Hermes.
COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/orchestrator/dist ./apps/orchestrator/dist
COPY --from=builder /app/apps/orchestrator/package.json ./apps/orchestrator/package.json
COPY --from=builder /app/apps/orchestrator/node_modules ./apps/orchestrator/node_modules
COPY --from=builder /app/apps/notebooklm-agent/dist ./apps/notebooklm-agent/dist
COPY --from=builder /app/apps/notebooklm-agent/package.json ./apps/notebooklm-agent/package.json
COPY --from=builder /app/apps/llm-gateway ./apps/llm-gateway
COPY --from=builder /app/apps/ml ./apps/ml
COPY --from=builder /app/packages/types ./packages/types
COPY --from=builder /app/lib/prompt-guard ./lib/prompt-guard
COPY --from=builder /app/lib/pattern-catalog ./lib/pattern-catalog
COPY --from=builder /app/lib/sigma-harness ./lib/sigma-harness
COPY --from=builder /app/lib/external-agent-registry ./lib/external-agent-registry
COPY --from=builder /app/lib/agent-task-core ./lib/agent-task-core
COPY --from=builder /app/lib/session-manager ./lib/session-manager
COPY --from=builder /app/lib/git-branch-orchestrator ./lib/git-branch-orchestrator
COPY --from=builder /app/lib/runtime ./lib/runtime
COPY --from=builder /app/lib/content-studio ./lib/content-studio
COPY --from=builder /app/lib/voice-messaging ./lib/voice-messaging
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/config/git-branch-policy.json ./config/git-branch-policy.json
COPY infra/hermes ./infra/hermes

RUN chmod +x /app/infra/hermes/docker-entrypoint.sh

# Workspace symlinks: Docker COPY breaks npm workspace symlinks that point
# outside node_modules (../../lib/*). Create explicit symlinks for transitive deps.
RUN mkdir -p node_modules/@intcloudsysops && \
    for pkg in universe content-studio game-core game-web; do \
      if [ -d "lib/${pkg}" ]; then ln -sf "../../lib/${pkg}" "node_modules/@intcloudsysops/${pkg}"; fi; \
    done

# Puerto HTTP interno del health server (mapear host 3012:3020 en compose si se desea :3012 en el host)
EXPOSE 3020

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -sf http://127.0.0.1:3020/health || exit 1

ENTRYPOINT ["/bin/sh", "/app/infra/hermes/docker-entrypoint.sh"]
