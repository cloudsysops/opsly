{
  "name": "peskids-platform",
  "version": "1.0.0",
  "description": "Standalone Peskids SaaS platform with AI-coordinated agents",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/agents/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces dev",
    "build": "npm run --workspaces build",
    "start": "npm run --workspaces start",
    "docker:build": "docker-compose -f infra/docker-compose.yml build",
    "docker:up": "docker-compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker-compose.yml down",
    "docker:logs": "docker-compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
